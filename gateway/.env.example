# Manul's gateway secrets, in one place. Copy to gateway/.env (never committed) and fill in what you have.
# - Local: docker compose passes all of it to Bifrost.
# - Production: deploy.sh (or k8s/set-secrets.sh alone) writes the non-empty values of the production keys below into
#   the cluster secret manul-secrets. Keys left empty keep what the cluster has (and the generated admin password and
#   Postgres login are only there). Local-only keys never leave this machine.

# ---- vendors (local and production)
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Azure AI Foundry: the resource's endpoint (https://<name>.services.ai.azure.com) and key
AZURE_ENDPOINT=
AZURE_API_KEY=

# ---- production only
# Clerk production: dashboard → API keys → Secret keys
CLERK_SECRET_KEY=
# Shared secret for registering pooled cloud/home workers (`MANUL_POOL_SECRET` on the worker)
WORKER_POOL_SECRET=
# Dodo Payments: Pitch's business (the plans are Pitch's). Production copies these from Pitch's secret pitch-runtime
# (k8s/link-pitch.sh); locally, use the test-mode key and products.
DODO_API_KEY=
DODO_PRODUCT_PRO_TEST=
DODO_PRODUCT_MAX_TEST=
DODO_PRODUCT_PRO_ANNUAL_TEST=
DODO_PRODUCT_MAX_ANNUAL_TEST=
DODO_PRODUCT_FLEX_TEST=

# ---- local only
# The development Manul key (virtual key vk-dev in config.json).
MANUL_DEV_KEY=sk-bf-dev-change-me
# Unlocks the local dashboard and admin API the first time (create the admin account, then per-user keys).
BIFROST_SETUP_TOKEN=change-me

# Local account service (npm run account:dev after starting account-db via Docker Compose).
ACCOUNT_DATABASE_URL=postgresql://manul:local-manul@127.0.0.1:55439/manul_account
# The wallet (Pitch's tables). Locally the same database: local.mjs creates the tables Manul reads.
WALLET_DATABASE_URL=postgresql://manul:local-manul@127.0.0.1:55439/manul_account
BIFROST_URL=http://127.0.0.1:8089
BIFROST_PROVIDERS=anthropic,gemini,openai
CLERK_ISSUER=https://clerk.agentshot.si
ACCOUNT_METADATA_KEY=manul_local
PUBLIC_URL=http://127.0.0.1:8090
PORT=8090
# After dashboard setup, set Basic base64(username:password) for the local admin API.
BIFROST_AUTH=
# Plans are granted by Pitch's Dodo webhook, so local checkouts only reach a wallet Pitch's API also writes to.
DODO_API=https://test.dodopayments.com
