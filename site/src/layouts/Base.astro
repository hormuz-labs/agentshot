---
import '@fontsource-variable/archivo/wdth.css'
import '@fontsource/ibm-plex-mono/500.css'
import '../styles/global.css'
import Cta from '../components/Cta.astro'
import { GH } from '../data/download'

interface Props {
  title: string
  description: string
  noindex?: boolean
}
const { title, description, noindex = false } = Astro.props
const canonical = new URL(Astro.url.pathname, 'https://agentshot.si')
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#0d0c11" />
  <!-- before first paint, so the page never flashes the wrong theme: the visitor's choice, else their system's -->
  <script is:inline>(() => {
    let t
    try { t = localStorage.getItem('theme') } catch {}
    if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark'
    document.documentElement.dataset.theme = t
    document.querySelector('meta[name="theme-color"]').content = t === 'light' ? '#f6f3ec' : '#0d0c11'
  })()</script>
  {noindex && <meta name="robots" content="noindex" />}
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon-48.png" sizes="48x48" type="image/png" />
  <link rel="icon" href="/favicon.png" sizes="32x32" type="image/png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content="https://agentshot.si/og.jpg" />
  <meta name="twitter:card" content="summary_large_image" />
  <!-- before first paint, so the button never shows the wrong system -->
  <script is:inline>(() => {
    const u = navigator.userAgent, phone = /iPhone|iPad|Android/.test(u) || (/Mac/.test(u) && navigator.maxTouchPoints > 1)
    document.documentElement.dataset.os = phone ? 'phone' : /Mac/.test(u) ? 'mac' : /Win/.test(u) ? 'win' : /Linux|X11/.test(u) ? 'linux' : 'any'
    // entrances wait for the motion script; if it hasn't run in 4 s (blocked, offline), show everything as it is
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.documentElement.classList.add('motion')
      setTimeout(() => { if (!window.__motion) document.documentElement.classList.remove('motion') }, 4000)
    }
  })()</script>
  <slot name="head" />
</head>
<body class:list={{ 'has-comparison': Astro.url.pathname.startsWith('/compare/') }}>
  <div class="playhead" aria-hidden="true"></div>
  <header class="top">
    <div class="wrap top-in">
      <a class="brand" href="/" aria-label="AgentShot home"><img src="/icon-56.png" width="28" height="28" alt="" /><span>AgentShot</span></a>
      <nav aria-label="Site">
        <a href="/#make" class="wide">What it makes</a>
        <a href="/#how" class="wide">How it works</a>
        <a href="/compare/" aria-current={Astro.url.pathname.startsWith('/compare/') ? 'page' : undefined}>Compare</a>
        <a href="/#pricing">Pricing</a>
        <a href={GH} class="source-link">GitHub</a>
      </nav>
      <button class="theme" type="button" data-theme-toggle aria-label="Switch theme" title="Switch theme">
        <svg class="to-light" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.2" /><path d="M12 2.5v2.2M12 19.3v2.2M4.3 4.3l1.6 1.6M18.1 18.1l1.6 1.6M2.5 12h2.2M19.3 12h2.2M4.3 19.7l1.6-1.6M18.1 5.9l1.6-1.6" /></svg>
        <svg class="to-dark" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.6A8.2 8.2 0 0 1 9.4 4a8.2 8.2 0 1 0 10.6 10.6Z" /></svg>
      </button>
      <div class="top-cta"><Cta small /></div>
    </div>
  </header>

  <slot />

  <footer class="foot">
    <div class="wrap foot-in">
      <a class="brand" href="/" aria-label="AgentShot home"><img src="/icon-56.png" width="28" height="28" alt="" /><span>AgentShot</span></a>
      <nav aria-label="Footer">
        <a href="/#get">Install</a>
        <a href="/pricing/">Pricing</a>
        <a href="/compare/">Compare editors</a>
        <a href={GH}>GitHub</a>
        <a href={`${GH}/blob/main/ROADMAP.md`}>Roadmap</a>
        <a href={`${GH}/releases`}>Releases</a>
        <a href="/privacy/">Privacy</a>
        <a href="/terms/">Terms</a>
        <a href="mailto:support@agentshot.si">support@agentshot.si</a>
      </nav>
      <p>© 2026 Hormuz Labs. Free and open source under the <a href={`${GH}/blob/main/LICENSE`}>GNU GPL v3 or later</a>. Demo clip: “Manul Timofey”, Moscow Zoo, <a href="https://commons.wikimedia.org/wiki/File:%D0%9C%D0%B0%D0%BD%D1%83%D0%BB_%D0%A2%D0%B8%D0%BC%D0%BE%D1%84%D0%B5%D0%B9_%D0%BD%D0%B0_%D1%80%D0%B0%D0%B7%D0%B6%D0%B8%D1%80%D0%BE%D0%B2%D0%BA%D0%B5.webm">CC BY 4.0</a>, edited.</p>
    </div>
  </footer>

  <div class="dock" id="dock" hidden>
    <Cta />
    <a class="btn ghost" href={GH}>Star on GitHub</a>
  </div>

  <script>
    const os = document.documentElement.dataset.os
    // "Download for Mac" is the Apple silicon build. Chrome and Edge can say which chip this Mac has, so an Intel Mac
    // gets the Intel build from the same button (Safari can't say; the hero and the install section link to it)
    const uad = (navigator as unknown as { userAgentData?: { getHighEntropyValues?: (h: string[]) => Promise<{ architecture?: string }> } }).userAgentData
    if (os === 'mac' && uad?.getHighEntropyValues) uad.getHighEntropyValues(['architecture']).then(v => {
      if (v.architecture === 'x86') document.querySelectorAll<HTMLAnchorElement>('a[data-intel]').forEach(a => (a.href = a.dataset.intel!))
    }).catch(() => {})

    // a phone can't run the app: hand the link to the visitor's computer
    document.querySelectorAll<HTMLButtonElement>('[data-send]').forEach(b => b.addEventListener('click', async () => {
      const url = 'https://agentshot.si/#get', text = 'AgentShot, the video editor you talk to. Install it on my computer.'
      const was = b.textContent
      try {
        if (navigator.share) { await navigator.share({ title: 'AgentShot', text, url }); return }
        await navigator.clipboard.writeText(url)
        b.textContent = 'Link copied'
        setTimeout(() => (b.textContent = was), 2200)
      } catch (e) {
        if ((e as Error).name !== 'AbortError') location.href = `mailto:?subject=${encodeURIComponent('AgentShot')}&body=${encodeURIComponent(`${text} ${url}`)}`
      }
    }))

    // light or dark: a choice made here sticks; until one is made the page follows the system
    const root = document.documentElement, themeMeta = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]')!
    const themeBtn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]')!
    const setTheme = (t: string) => {
      root.dataset.theme = t
      themeMeta.content = t === 'light' ? '#f6f3ec' : '#0d0c11'
      themeBtn.setAttribute('aria-label', t === 'light' ? 'Switch to dark theme' : 'Switch to light theme')
    }
    setTheme(root.dataset.theme || 'dark')
    themeBtn.addEventListener('click', () => {
      const t = root.dataset.theme === 'light' ? 'dark' : 'light'
      setTheme(t)
      try { localStorage.setItem('theme', t) } catch {}
    })
    matchMedia('(prefers-color-scheme: light)').addEventListener('change', e => {
      let chosen = null
      try { chosen = localStorage.getItem('theme') } catch {}
      if (!chosen) setTheme(e.matches ? 'light' : 'dark')
    })

    document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach(b => b.addEventListener('click', async () => {
      const was = b.textContent
      try { await navigator.clipboard.writeText(b.dataset.copy!); b.textContent = 'Copied' } catch { b.textContent = 'Select and copy' }
      setTimeout(() => (b.textContent = was), 1800)
    }))

    // the header gets out of the way going down and comes back going up; small jitters of the finger don't count
    const top = document.querySelector<HTMLElement>('.top')!
    let last = scrollY, queued = false
    addEventListener('scroll', () => {
      if (queued) return
      queued = true
      requestAnimationFrame(() => {
        queued = false
        if (Math.abs(scrollY - last) < 6) return
        top.classList.toggle('away', scrollY > last && scrollY > 120 && !top.matches(':focus-within'))
        top.classList.toggle('scrolled', scrollY > 20)
        last = scrollY
      })
    }, { passive: true })

    // the phone's bar comes in once the hero's button has scrolled away
    const hero = document.querySelector('[data-hero-cta]'), dock = document.getElementById('dock')!
    if (os === 'phone' && hero) new IntersectionObserver(([e]) => (dock.hidden = e.isIntersecting || e.boundingClientRect.top > 0)).observe(hero)
    else if (os === 'phone') dock.hidden = false
  </script>
  <script>import '../scripts/motion'</script>
</body>
</html>
