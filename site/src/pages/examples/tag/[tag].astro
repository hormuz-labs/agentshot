---
// One page per kind of motion example (kinetic type, product UI, charts…).
import Base from '../../../layouts/Base.astro'
import Cta from '../../../components/Cta.astro'
import ExampleCards from '../../../components/ExampleCards.astro'
import ExampleTags from '../../../components/ExampleTags.astro'
import { EXAMPLES, TAGS, TAG_WORDS, examplePath, tagPath, tagSlug } from '../../../data/examples'

export function getStaticPaths() {
  return TAGS.map(t => ({ params: { tag: tagSlug(t.tag) }, props: { tag: t.tag } }))
}
interface Props { tag: string }
const { tag } = Astro.props
const list = EXAMPLES.filter(e => e.tags.includes(tag))
const words = TAG_WORDS[tag] ?? `${tag.toLowerCase()} animations`
const title = `${tag}: ${list.length} motion graphics prompts and examples · AgentShot`
const description = `${list.length} examples of ${words}, made with Claude, each with the exact prompt behind it. Copy a prompt and make your own in AgentShot.`
const url = `https://agentshot.si${tagPath(tag)}`
---
<Base title={title} description={description} image="/og/examples.jpg">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org', '@type': 'CollectionPage', name: title, description, url,
      mainEntity: { '@type': 'ItemList', numberOfItems: list.length, itemListElement: list.map((e, i) => ({ '@type': 'ListItem', position: i + 1, name: e.title, url: `https://agentshot.si${examplePath(e.id)}` })) },
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'AgentShot', item: 'https://agentshot.si/' },
        { '@type': 'ListItem', position: 2, name: 'Motion examples', item: 'https://agentshot.si/examples/' },
        { '@type': 'ListItem', position: 3, name: tag, item: url },
      ],
    })} />
  </Fragment>
  <main class="examples wrap">
    <header class="sec-head">
      <a class="back mono" href="/examples/">← All motion examples</a>
      <span class="tag">{tag}</span>
      <h1>{list.length} {words}. <span class="grad">With the prompts.</span></h1>
      <p>Each one was made by someone talking to Claude, and each page shows the exact prompt they used. Pick one and tell AgentShot what yours is about.</p>
      <div class="hero-actions" data-hero-cta><a class="btn go" href="/#get">Get AgentShot, free <span aria-hidden="true">↗</span></a></div>
    </header>
    <ExampleTags current={tag} />
    <ExampleCards examples={list} eager={6} />
    <section class="try-editor" aria-labelledby="try-h"><h2 id="try-h">Make one <span class="grad">about your thing.</span></h2><p>The same gallery sits under the message box in AgentShot. Pick an example and say what yours is about.</p><div class="plan-cta"><Cta /></div></section>
  </main>
</Base>

<style>
  .examples { padding-top: clamp(32px, 6vw, 80px); padding-bottom: 56px; }
  .back { display: flex; align-items: center; width: fit-content; min-height: 44px; margin-bottom: 16px; color: var(--ink-2); font-size: 12px; text-decoration: none; }
  .back:hover { color: var(--ink); }
  .sec-head { max-width: 1000px; margin-bottom: 36px; }
  .sec-head h1 { font-size: clamp(36px, 5vw, 68px); line-height: 1.02; letter-spacing: -.04em; }
  h1 .grad { display: block; margin-top: 8px; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 28px; }
  .hero-actions .btn { font-size: 16px; padding-inline: 24px; }
  .examples :global(.example-cards) { margin-top: 32px; }
  .try-editor { margin-top: var(--gap); }
  .try-editor p { margin-top: 20px; color: var(--ink-2); max-width: 700px; }
  .plan-cta { max-width: 580px; margin-top: 28px; }
  @media (max-width: 760px) { .hero-actions .btn { flex: 1 1 auto; min-width: 0; font-size: 15px; padding-inline: 20px; } }
</style>
