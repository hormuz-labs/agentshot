---
import '@fontsource-variable/albert-sans'
import '@fontsource/ibm-plex-mono/600.css'
import '../styles/global.css'
import Pricing from '../components/Pricing.astro'
import { OFFERS, PRICING_FAQS, PLAN_SUMMARY } from '../data/plans'
import release from '../release.json'

const gh = 'https://github.com/hormuz-labs/agentshot'
const brew = 'brew install hormuz-labs/tap/manul'
const title = 'Pricing · AgentShot: free with your own keys, or one AgentShot key'
const description = `AgentShot, the open-source video agent for macOS, Windows and Linux, is free forever with your own model keys. ${PLAN_SUMMARY}`
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#fdfdf6" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon-48.png" sizes="48x48" type="image/png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="canonical" href="https://agentshot.si/pricing/" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://agentshot.si/pricing/" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content="https://agentshot.si/og.jpg" />
  <meta name="twitter:card" content="summary_large_image" />
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: 'AgentShot', applicationCategory: 'MultimediaApplication',
    operatingSystem: 'macOS, Windows, Linux', url: 'https://agentshot.si/', softwareVersion: release.version, offers: OFFERS,
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: PRICING_FAQS.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, '') } })),
  })} />
</head>
<body>
  <header class="top wrap">
    <a class="brand" href="/" aria-label="AgentShot home"><img src="/icon-56.png" width="28" height="28" alt="" /><span>AgentShot</span></a>
    <nav aria-label="Site">
      <a href="/">Product</a>
      <a href="/#build" class="more">Developers</a>
      <a href={gh} class="more">GitHub ↗</a>
      <a href="/#get" class="btn sm">Download</a>
    </nav>
  </header>

  <main>
    <Pricing heading="h1" />

    <section class="wrap qs" aria-labelledby="q-h">
      <h2 class="slate" id="q-h">Plans and credits, answered</h2>
      {PRICING_FAQS.map(f => <details><summary>{f.q}</summary><p set:html={f.a} /></details>)}
    </section>

    <section class="wrap end">
      <h2 class="slate">Start free. Decide later.</h2>
      <p>Install AgentShot, add a key or sign in, and give it a note. Plans live in the app, under Settings → Keys → AgentShot key.</p>
      <div class="row">
        <a href="/#get" class="btn dot"><span class="ic"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" d="M12 4v11m0 0-4.5-4.5M12 15l4.5-4.5M5 20h14"/></svg></span>Download AgentShot</a>
        <a href={gh} class="btn light">Star on GitHub</a>
      </div>
      <p class="mono brew">$ {brew}</p>
    </section>
  </main>

  <footer class="wrap foot label">
    <span>© 2026 Hormuz Labs · <a href="/privacy/">Privacy</a> · <a href="/terms/">Terms</a> · <a href={`${gh}/blob/main/LICENSE`}>Apache-2.0</a></span>
    <a href="/">Back to AgentShot</a>
  </footer>

  <style>
    .top { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 64px; }
    .brand { display: inline-flex; align-items: center; gap: 9px; text-decoration: none; font: 800 19px/1 var(--sans); letter-spacing: -.02em; }
    .brand img { border-radius: 7px; }
    nav { display: flex; align-items: center; gap: 4px; }
    nav a:not(.btn) { padding: 8px 12px; border-radius: 8px; font: 500 14px/1 var(--sans); text-decoration: none; }
    nav a:not(.btn):hover { background: rgba(38, 38, 38, .06); }
    main :global(.pricing) { padding-top: 24px; }
    main :global(.pricing .sh) { max-width: 920px; }
    main :global(.pricing h1) { margin: 0; font-size: clamp(36px, 5vw, 60px); letter-spacing: -.035em; }
    .qs { max-width: 820px; padding-top: 96px; }
    .qs h2 { margin: 0 0 20px; font-size: clamp(28px, 3vw, 36px); }
    details { border-bottom: 1px solid var(--line); }
    details:first-of-type { border-top: 1px solid var(--line); }
    summary { list-style: none; cursor: pointer; padding: 20px 0; font: 600 17.5px/1.35 var(--sans); display: flex; justify-content: space-between; align-items: center; gap: 16px; }
    summary::-webkit-details-marker { display: none; }
    summary::after { content: '+'; flex: none; display: grid; place-items: center; width: 28px; height: 28px; border-radius: 50%; box-shadow: inset 0 0 0 1px var(--line); font: 500 18px/1 var(--sans); transition: transform .2s; }
    details[open] summary::after { transform: rotate(45deg); background: var(--ink); color: #fff; box-shadow: none; }
    details p { margin: 0 0 20px; color: var(--ink-2); }
    details :global(a) { color: var(--ink); text-underline-offset: 3px; }
    .end { display: flex; flex-direction: column; align-items: center; text-align: center; padding-block: 104px 96px; }
    .end h2 { margin: 0; font-size: clamp(32px, 4vw, 48px); }
    .end p { margin: 12px 0 0; max-width: 560px; color: var(--ink-2); }
    .row { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin-top: 24px; }
    .brew { font-size: 13px; color: var(--ink-3); }
    .foot { display: flex; justify-content: space-between; gap: 16px 28px; flex-wrap: wrap; padding-block: 26px 64px; border-top: 1px solid var(--line); font-size: 14px; }
    .foot a { color: var(--ink-2); text-underline-offset: 3px; }
    @media (max-width: 640px) { nav .more { display: none; } }
  </style>
</body>
</html>
