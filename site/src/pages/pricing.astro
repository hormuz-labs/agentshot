---
import Base from '../layouts/Base.astro'
import Pricing from '../components/Pricing.astro'
import { OFFERS, PRICING_FAQS, PLAN_SUMMARY } from '../data/plans'
import { version } from '../data/download'

const title = 'Pricing · AgentShot: free with your own key'
const description = `AgentShot, the open-source video editor you talk to, is free forever with your own model keys. ${PLAN_SUMMARY}`
---
<Base title={title} description={description}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: 'AgentShot', applicationCategory: 'MultimediaApplication',
      operatingSystem: 'macOS, Windows, Linux', url: 'https://agentshot.si/', softwareVersion: version, offers: OFFERS,
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org', '@type': 'FAQPage',
      mainEntity: PRICING_FAQS.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, '') } })),
    })} />
  </Fragment>
  <main>
    <Pricing heading="h1" full />
    <section class="sec wrap faq">
      <h2>Questions about plans</h2>
      <div class="qs">{PRICING_FAQS.map(f => <details><summary>{f.q}</summary><p set:html={f.a} /></details>)}</div>
    </section>
  </main>
</Base>

<style>
  .faq h2 { margin-bottom: 32px; }
  .qs { max-width: 860px; border-top: 1px solid var(--line); }
  details { border-bottom: 1px solid var(--line); }
  summary { padding: 18px 0; font-size: 19px; font-weight: 600; cursor: pointer; }
  details p { padding-bottom: 20px; color: var(--ink-2); }
</style>
