---
import Base from '../../layouts/Base.astro'
import Cta from '../../components/Cta.astro'
import ComparisonCards from '../../components/ComparisonCards.astro'
import ComparisonSignal from '../../components/ComparisonSignal.astro'
import { AGENTSHOT_SOURCES, COMPARISONS, REVIEWED, REVIEWED_LABEL, SCARLET_COMMIT, comparisonPath, type Comparison } from '../../data/comparisons'

export function getStaticPaths() {
  return COMPARISONS.map(comparison => ({ params: { competitor: comparison.slug }, props: { comparison } }))
}
interface Props { comparison: Comparison }
const { comparison: c } = Astro.props
const title = `AgentShot vs ${c.name}: ${c.hook}`
const url = `https://agentshot.si${comparisonPath(c.slug)}`
const sources = [...AGENTSHOT_SOURCES, ...c.sources]
const ref = (id: string) => sources.findIndex(s => s.id === id) + 1
---
<Base title={title} description={c.description}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org', '@type': 'Article', headline: title, description: c.description,
      datePublished: REVIEWED, dateModified: REVIEWED, mainEntityOfPage: url,
      author: { '@type': 'Organization', name: 'Hormuz Labs', url: 'https://agentshot.si/' },
      publisher: { '@type': 'Organization', name: 'Hormuz Labs', url: 'https://agentshot.si/' },
      about: [{ '@type': 'SoftwareApplication', name: 'AgentShot', url: 'https://agentshot.si/' }, { '@type': 'SoftwareApplication', name: c.name }],
      citation: sources.map(s => s.url),
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'AgentShot', item: 'https://agentshot.si/' },
        { '@type': 'ListItem', position: 2, name: 'Compare', item: 'https://agentshot.si/compare/' },
        { '@type': 'ListItem', position: 3, name: `AgentShot vs ${c.name}`, item: url },
      ],
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: c.faqs.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
    })} />
  </Fragment>
  <main class="comparison-page wrap" style={`--c: var(--${c.tone})`}>
    <article>
      <header class="comparison-hero">
        <div class="hero-copy">
          <a class="back mono" href="/compare/">← All comparisons</a>
          <span class="tag">AgentShot vs {c.name}</span>
          <h1>AgentShot vs {c.name}<span class="grad">{c.hook}</span></h1>
          <p class="verdict">{c.verdict}</p>
          <p class="byline mono">By Hormuz Labs, makers of AgentShot · Reviewed <time datetime={REVIEWED}>{REVIEWED_LABEL}</time></p>
          <div class="hero-actions" data-hero-cta><a class="btn go" href="/#get">Try AgentShot <span aria-hidden="true">↗</span></a><a class="btn ghost" href="#differences">See the differences</a></div>
        </div>
        <ComparisonSignal competitor={c.name} />
      </header>

      <nav class="chapter-nav" aria-label="On this page"><span class="mono">In this comparison</span><a href="#differences">Side by side</a><a href="#advantages">AgentShot advantages</a><a href="#fit">Verdict</a><a href="#questions">FAQ</a><a href="#sources">Sources <span aria-hidden="true">↗</span></a></nav>

      <section class="overview" aria-labelledby="overview-h">
        <h2 id="overview-h">What is {c.name}?</h2>
        <p>{c.overview}</p>
        <p class="references">Sources: {c.overviewSources.map(id => <a href={`#source-${id}`} aria-label={`Source ${ref(id)}`}>[{ref(id)}]</a>)}</p>
      </section>

      <section class="chapter" id="differences" aria-labelledby="differences-h">
        <div class="sec-head">
          <span class="tag">the differences</span>
          <h2 id="differences-h">Side by side. <span class="grad">No mystery ticks.</span></h2>
          <p>What you get with each, from their own pages and ours. Every row links to its source.</p>
        </div>
        <p class="scroll-hint mono" aria-hidden="true">Swipe to compare <span>↔</span></p>
        <div class="table-scroll" role="region" tabindex="0" data-lenis-prevent aria-label={`Feature comparison: AgentShot vs ${c.name}`}>
          <table role="table">
            <caption>AgentShot vs {c.name} — reviewed {REVIEWED_LABEL}</caption>
            <thead role="rowgroup"><tr role="row"><th scope="col" role="columnheader">What matters</th><th scope="col" role="columnheader" class="us">AgentShot</th><th scope="col" role="columnheader">{c.name}</th></tr></thead>
            <tbody role="rowgroup">{c.rows.map(row => (
              <tr role="row">
                <th scope="row" role="rowheader">{row.feature}<span class="row-refs">{row.sources.map(id => <a href={`#source-${id}`} aria-label={`Source ${ref(id)} for ${row.feature}`}>[{ref(id)}]</a>)}</span></th>
                <td class="us" role="cell"><span class="cell-label mono" aria-hidden="true">AgentShot</span>{row.us}</td><td role="cell"><span class="cell-label mono" aria-hidden="true">{c.name}</span>{row.them}</td>
              </tr>
            ))}</tbody>
          </table>
        </div>
        <p class="table-note">The Local app is free; AI-provider use is billed separately. Remote models can receive text and still frames. Optional cloud workers are a different workflow.</p>
      </section>

      <section class="chapter" id="advantages" aria-labelledby="advantages-h">
        <div class="sec-head"><span class="tag">why choose AgentShot</span><h2 id="advantages-h">Where AgentShot <span class="grad">goes further.</span></h2></div>
        <div class="advantages">{c.advantages.map((a, i) => (
          <section>
            <span class="number mono">0{i + 1} / Your advantage</span><h3>{a.title}</h3><p>{a.text}</p>
            <p class="references">Sources: {a.sources.map(id => <a href={`#source-${id}`} aria-label={`Source ${ref(id)}`}>[{ref(id)}]</a>)}</p>
          </section>
        ))}</div>
      </section>

      <section class="note-example chapter" aria-labelledby="note-h">
        <div><span class="tag">one note, a real workflow</span><h2 id="note-h">Say what <span class="grad">you want made.</span></h2><p>{c.outcome}</p></div>
        <blockquote><span class="mono">You say</span><p>“{c.prompt}”</p><a href="/#try">Try the before-and-after demo <span aria-hidden="true">↗</span></a></blockquote>
      </section>

      <section class="chapter" id="fit" aria-labelledby="fit-h">
        <div class="sec-head"><span class="tag">the verdict</span><h2 id="fit-h">Switch to AgentShot <span class="grad">if this is you.</span></h2></div>
        <div class="fit">
          <section class="fit-us"><h3>Choose AgentShot if…</h3><p>{c.chooseUs}</p><a class="btn go" href="/#get">Get AgentShot, free <span aria-hidden="true">↗</span></a></section>
          <p class="fit-them"><b>Stay with {c.name} only if:</b> {c.chooseThem.charAt(0).toLowerCase() + c.chooseThem.slice(1)}</p>
        </div>
      </section>

      <section class="chapter questions" id="questions" aria-labelledby="questions-h">
        <div class="sec-head"><span class="tag">questions</span><h2 id="questions-h">AgentShot vs {c.name}: FAQ</h2></div>
        {c.faqs.map(f => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
      </section>

      <section class="chapter sources" id="sources" aria-labelledby="sources-h">
        <span class="tag">check the claims</span><h2 id="sources-h">The sources behind the comparison.</h2>
        <p>Written by the makers of AgentShot, from each product’s own pages, reviewed {REVIEWED_LABEL}. Plans and features change; the links show what we read.</p>
        {c.slug === 'scarlet' && <p>Scarlet sources are pinned to main-branch commit <code>{SCARLET_COMMIT.slice(0, 12)}</code>, rather than assuming its current main branch will always match this page.</p>}
        <ol>{sources.map(s => <li id={`source-${s.id}`}><a href={s.url}>{s.label} <span aria-hidden="true">↗</span></a></li>)}</ol>
      </section>
    </article>

    <section class="chapter related" aria-labelledby="related-h"><h2 id="related-h">Another editor on your list?</h2><ComparisonCards exclude={c.slug} /></section>
    <section class="chapter try-editor" aria-labelledby="try-h"><h2 id="try-h">Your next cut. <span class="grad">Your call.</span></h2><p>Download AgentShot and give it a note. Free Local editor with your own model key; provider usage costs extra.</p><div class="plan-cta"><Cta /></div></section>
  </main>
</Base>

<style>
  .comparison-page { padding-top: clamp(32px, 6vw, 80px); padding-bottom: 56px; }
  .comparison-hero { display: grid; grid-template-columns: minmax(0, 1.65fr) minmax(0, 1fr); align-items: center; gap: clamp(32px, 5vw, 72px); }
  .hero-copy { min-width: 0; }
  .back { display: flex; align-items: center; width: fit-content; min-height: 44px; margin-bottom: 24px; color: var(--ink-2); font-size: 12px; text-decoration: none; }
  .back:hover { color: var(--ink); }
  h1 { font-size: clamp(38px, 4.8vw, 68px); line-height: 1.02; letter-spacing: -.04em; }
  h1 .grad { display: block; margin-top: 12px; }
  .verdict { max-width: 860px; margin-top: 26px; font-size: clamp(18px, 1.7vw, 22px); color: var(--ink-2); }
  .byline { max-width: 520px; margin-top: 22px; font-size: 12px; line-height: 1.8; color: var(--ink-2); }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 28px; }
  .hero-actions .btn { font-size: 16px; padding-inline: 24px; }
  .chapter-nav { display: flex; align-items: center; flex-wrap: wrap; gap: 4px 10px; margin-top: clamp(40px, 5vw, 64px); padding-block: 14px; border-block: 1px solid var(--line); }
  .chapter-nav > .mono { margin-right: auto; padding-right: 16px; color: var(--ink-2); font-size: 12px; }
  .chapter-nav a { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 8px 12px; border-radius: 999px; color: var(--ink-2); font-size: 13px; text-decoration: none; }
  .chapter-nav a:hover { background: var(--bg-2); color: var(--ink); }
  .overview { max-width: 920px; margin-top: clamp(44px, 6vw, 76px); padding-top: 24px; border-top: 1px solid var(--line); }
  .overview h2 { font-size: clamp(26px, 3vw, 38px); }
  .overview > p { margin-top: 16px; color: var(--ink-2); }
  .chapter { margin-top: clamp(72px, 9vw, 128px); scroll-margin-top: 90px; }
  .references { display: flex; flex-wrap: wrap; gap: 8px; color: var(--ink-2); font-size: 13px; }
  .references a, .row-refs a { color: var(--text-sky); }
  .table-scroll { max-width: 100%; overflow-x: auto; border: 1px solid var(--line); border-radius: var(--r); background: var(--bg-2); }
  .scroll-hint, .cell-label { display: none; }
  table { width: 100%; min-width: 760px; border-collapse: collapse; text-align: left; }
  caption { padding: 18px 24px; text-align: left; font: 500 12px/1.5 var(--mono); color: var(--ink-2); }
  th, td { padding: 22px 24px; border-top: 1px solid var(--line); vertical-align: top; font-size: 15.5px; line-height: 1.5; }
  thead th { font-size: 21px; }
  th:first-child { width: 23%; }
  td { width: 38.5%; color: var(--ink-2); }
  .us { background: color-mix(in srgb, var(--violet) 9%, var(--bg-2)); color: var(--ink); }
  thead .us { background: color-mix(in srgb, var(--violet) 20%, var(--bg-2)); color: var(--text-yellow); box-shadow: inset 0 3px var(--yellow); }
  .row-refs { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 10px; font: 500 12px/1.5 var(--mono); }
  .table-note { margin-top: 14px; max-width: 920px; font-size: 14px; color: var(--ink-2); }
  .advantages { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  .advantages section { padding: clamp(24px, 3vw, 36px); border: 1px solid var(--line); border-radius: var(--r); background: linear-gradient(145deg, color-mix(in srgb, var(--violet) 5%, var(--bg-2)), var(--bg-2) 60%); }
  .number { font-size: 12px; color: var(--text-sky); }
  .advantages h3 { margin-top: 16px; }
  .advantages p { margin-top: 14px; color: var(--ink-2); }
  .advantages .references { margin-top: 18px; }
  .note-example { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 36px 60px; align-items: center; }
  .note-example h2 { font-size: clamp(32px, 4.4vw, 56px); }
  .note-example > div > p { margin-top: 20px; color: var(--ink-2); }
  blockquote { margin: 0; padding: clamp(24px, 4vw, 44px); background: var(--bg-2); border: 1px solid var(--line); border-radius: 26px 26px 6px 26px; box-shadow: 0 36px 100px -60px var(--violet); }
  blockquote .mono { font-size: 12px; color: var(--ink-2); }
  blockquote p { margin-top: 16px; font-size: clamp(22px, 2.5vw, 32px); font-weight: 700; line-height: 1.3; letter-spacing: -.015em; }
  blockquote a { display: inline-block; margin-top: 24px; color: var(--text-yellow); font-size: 14px; }
  .fit { display: grid; gap: 16px; max-width: 920px; }
  .fit .btn { margin-top: 24px; }
  .fit-them { padding: 0 4px; color: var(--ink-2); font-size: 15px; }
  .fit-them b { color: var(--ink); }
  .fit section { padding: clamp(24px, 3.5vw, 40px); border: 1px solid var(--line); border-radius: var(--r); background: var(--bg-2); }
  .fit .fit-us { border-color: color-mix(in srgb, var(--yellow) 28%, var(--line)); background: radial-gradient(ellipse at 0 0, color-mix(in srgb, var(--yellow) 5%, transparent), transparent 75%), var(--bg-2); box-shadow: inset 0 3px var(--yellow); }
  .fit p { margin-top: 16px; color: var(--ink-2); }
  .questions { max-width: 920px; }
  details { border-block-end: 1px solid var(--line); }
  details:first-of-type { border-top: 1px solid var(--line); }
  summary { display: flex; justify-content: space-between; gap: 20px; padding: 22px 0; font-weight: 700; font-size: 19px; cursor: pointer; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; color: var(--text-yellow); flex: none; }
  details[open] summary::after { content: '−'; }
  details p { padding-bottom: 24px; max-width: 820px; color: var(--ink-2); }
  .sources { max-width: 920px; padding-top: 24px; border-top: 1px solid var(--line); }
  .sources h2 { font-size: clamp(28px, 3.5vw, 44px); }
  .sources p { margin-top: 18px; color: var(--ink-2); font-size: 15px; }
  .sources ol { padding-left: 28px; margin-top: 24px; }
  .sources li { padding: 8px 0 8px 6px; color: var(--ink-2); font-size: 14px; scroll-margin-top: 90px; overflow-wrap: anywhere; }
  .sources li::marker { color: var(--text-sky); font-family: var(--mono); }
  .related h2 { font-size: clamp(28px, 3.4vw, 44px); margin-bottom: 28px; }
  .try-editor p { margin-top: 20px; color: var(--ink-2); max-width: 700px; }
  .plan-cta { margin-top: 28px; max-width: 580px; }
  @media (max-width: 1000px) { .chapter-nav > .mono { flex-basis: 100%; padding-block: 6px; } }
  @media (min-width: 601px) and (max-width: 800px) { .scroll-hint { display: flex; justify-content: space-between; margin-bottom: 12px; font-size: 12px; color: var(--ink-2); } }
  @media (max-width: 760px) {
    .comparison-hero, .advantages, .note-example, .fit { grid-template-columns: minmax(0, 1fr); }
    h1 { font-size: clamp(38px, 7.4vw, 56px); }
    .verdict { font-size: 18px; line-height: 1.6; }
    .back { margin-bottom: 16px; }
    .chapter-nav { flex-wrap: nowrap; overflow-x: auto; margin-top: 32px; gap: 4px; padding-block: 8px; scrollbar-width: thin; scrollbar-color: var(--line) transparent; }
    .chapter-nav > .mono { display: none; }
    .chapter-nav a { flex: none; }
    .overview { margin-top: 40px; }
    .hero-actions .btn { padding-inline: 20px; }
    th, td { padding: 18px; }
    summary { font-size: 17px; line-height: 1.4; }
    .questions .sec-head h2 { font-size: clamp(30px, 6vw, 44px); }
  }
  @media (max-width: 600px) {
    .table-scroll { border: 0; border-radius: 0; background: none; overflow: visible; }
    table { display: block; min-width: 0; }
    caption { display: block; padding: 0 0 18px; font-size: 12px; }
    thead { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
    tbody { display: grid; gap: 16px; }
    tbody tr { display: grid; min-width: 0; overflow: hidden; border: 1px solid var(--line); border-radius: 18px; background: var(--bg-2); }
    th:first-child, td { width: auto; }
    tbody th { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; border: 0; padding: 18px 20px; font-size: 16px; background: var(--bg-3); }
    .row-refs { flex: none; margin: 0; gap: 6px; font-size: 12px; }
    td { display: block; padding: 20px; font-size: 15px; line-height: 1.65; }
    .cell-label { display: block; margin-bottom: 8px; color: var(--ink-2); font-size: 12px; }
    .us .cell-label { color: var(--text-yellow); }
    .table-note { margin-top: 20px; font-size: 13px; }
    .hero-actions .btn { flex: 1 1 auto; min-width: 0; font-size: 15px; }
    .comparison-page { padding-bottom: 32px; }
  }
</style>
