---
// An installer's own page: it starts the download from GitHub and says what to do with it. The buttons come here
// (data/download.ts), so a download counts as a view of this page. Nothing here needs scripts: the download starts
// from the page's own refresh, and the link under the heading is the same file for a browser that won't.
import Base from '../../layouts/Base.astro'
import { DOWNLOADS, GH, type Download } from '../../data/download'
import { STARTER_CREDITS, fmt } from '../../data/plans'

export const getStaticPaths = () => Object.keys(DOWNLOADS).map(target => ({ params: { target } }))

const d = DOWNLOADS[Astro.params.target as Download]
const first = {
  mac: ['Open the .dmg from your Downloads folder.', 'Drag AgentShot into Applications, then open it.'],
  windows: ['Run the Setup file from your Downloads folder. It installs in one click.', 'If SmartScreen asks once: More info, then Run anyway.'],
  deb: [`In a terminal, from your Downloads folder: sudo apt install ./${d.file}`, 'Open AgentShot from your applications.'],
  appimage: [`In a terminal, from your Downloads folder: chmod +x ${d.file}`, 'Run it.'],
}[d.system]
const steps = [...first, `Sign in for ${fmt(STARTER_CREDITS)} free credits or paste your own model key, and drop in a video.`]
---
<Base title="Your download · AgentShot" description={`${d.label}: the download starts by itself.`} noindex>
  <meta slot="head" http-equiv="refresh" content={`1; url=${d.url}`} />
  <main class="sec wrap" data-download={Astro.params.target}>
    <h1>Your download <mark>is starting.</mark></h1>
    <p class="again">{d.label}. If nothing happens, <a href={d.url} data-file>download it here</a>.</p>

    <ol class="steps" role="list">
      {steps.map((s, i) => <li><b class="mono">{i + 1}</b><span>{s}</span></li>)}
    </ol>

    <section class="star" aria-label="While it downloads">
      <h2>While it downloads</h2>
      <p>AgentShot is free and open source. If you like where it’s going, a star on GitHub helps other people find it.</p>
      <p class="row"><a class="btn go" href={GH}>Star it on GitHub</a><a class="btn ghost" href="/">Back to AgentShot</a></p>
    </section>
  </main>
</Base>

<style>
  h1 { font-size: clamp(44px, 8vw, 104px); }
  .again { margin-top: 24px; max-width: 720px; font-size: clamp(17px, 1.6vw, 20px); color: var(--ink-2); }
  .steps { display: grid; gap: 12px; max-width: 820px; margin: clamp(36px, 5vw, 56px) 0 0; padding: 0; list-style: none; }
  .steps li { display: flex; align-items: baseline; gap: 16px; padding: 18px 20px; border: 1px solid var(--line); border-radius: var(--r); background: var(--bg-2); font-size: clamp(16px, 1.5vw, 19px); overflow-wrap: anywhere; }
  .steps b { flex: none; font-size: 14px; color: var(--yellow); }
  .star { max-width: 820px; margin-top: clamp(48px, 7vw, 88px); }
  .star h2 { font-size: clamp(26px, 3.4vw, 40px); }
  .star p { margin-top: 12px; color: var(--ink-2); }
  .row { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 24px !important; }
</style>
