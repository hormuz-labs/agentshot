---
import Base from '../layouts/Base.astro'
import Cta from '../components/Cta.astro'
import Demo from '../components/Demo.astro'
import Pricing from '../components/Pricing.astro'
import motion from '../data/motion.json'
import { OFFERS, PRICING_FAQS, PLAN_SUMMARY, STARTER_CREDITS, fmt } from '../data/plans'
import { GH as gh, version, MAC_ARM, MAC_INTEL, WINDOWS, DEB, DEB_ARM, APPIMAGE, APPIMAGE_ARM, BREW, APT, AGENT_PROMPT } from '../data/download'
import { clips, diamond, note, play, reel, spark, spark4, wave } from '../lib/shapes'

const title = 'AgentShot: the video editor you talk to. Free and open source.'
const description = 'Give notes, get cuts. Say what you want, point at the frame, and keep the cut or send it back. AgentShot runs on your computer, for macOS, Windows and Linux. Free with your own model key.'
// motion examples from the gallery inside AgentShot: made by the people credited, with Claude; collected by prompt-motion.com.
// Videos and posters stream from AgentShot's bucket (scripts/publish-motion-gallery.mjs in the app's repo).
const media = 'https://storage.googleapis.com/manul-gallery/v1'
const clock = (s: number) => `${Math.floor(s / 60)}:${String(Math.round(s % 60)).padStart(2, '0')}`

// a trace under each line of the readout, drawn here so the page ships no script for it (600 × 28, seeded so it never changes)
let seed = 7
const rnd = () => ((seed = (seed * 16807) % 2147483647) / 2147483647)
const W = 600, H = 28
const f1 = (n: number) => Math.round(n * 10) / 10
function wordsTrace() {
  let x = 0, out = '', i = 0
  while (x < W) {
    const um = i === 4 || i === 17, w = um ? 9 : 6 + rnd() * 22
    i++
    out += `<rect x="${f1(x)}" y="${um ? 9 : 10}" width="${f1(w)}" height="${um ? 10 : 8}" class="${um ? 'r' : 'p'}"/>`
    x += w + (rnd() < .12 ? 14 + rnd() * 16 : 3)
  }
  return out
}
const voicesTrace = () => [[0, 70, 0], [70, 190, 1], [190, 240, 0], [240, 380, 1], [380, 470, 0], [470, 530, 1], [530, 600, 0]]
  .map(([a, b, v]) => `<rect x="${a}" y="${v ? 15 : 7}" width="${b - a - 2}" height="6" class="${v ? 'q' : 'p'}"/>`).join('')
function shotsTrace() {
  const cuts = [0, 46, 118, 150, 230, 268, 342, 400, 455, 520, 600]
  let out = ''
  cuts.slice(0, -1).forEach((a, i) => {
    const b = cuts[i + 1], shaky = i === 2 || i === 6, frozen = i === 8
    if (shaky) {
      let d = `M${a + 3} 14`
      for (let x = a + 3; x < b - 3; x += 4) d += ` L${x} ${f1(14 + (rnd() - .5) * 14)}`
      out += `<path d="${d}" class="rl"/>`
    } else out += `<rect x="${a + 2}" y="${frozen ? 6 : 12}" width="${b - a - 4}" height="${frozen ? 16 : 4}" class="${frozen ? 'r' : 'p'}"/>`
    if (i) out += `<rect x="${a - 1}" y="2" width="2" height="24" class="q"/>`
  })
  return out
}
function subjectTrace() {
  let d = '', band = ''
  for (let x = 0; x <= W; x += 10) {
    const y = 14 + Math.sin(x / 70) * 7 + Math.sin(x / 23) * 2
    d += `${x ? 'L' : 'M'}${x} ${f1(y)} `
    if (x % 60 === 0) band += `<rect x="${x - 4}" y="${f1(y - 10)}" width="8" height="20" class="b"/>`
  }
  return band + `<path d="${d}" class="rl"/>`
}
function musicTrace() {
  let out = ''
  for (let i = 0, x = 4; x < W; i++, x += 9.4) {
    const bar = i % 4 === 0, drop = i === 40
    out += `<rect x="${f1(x)}" y="${drop ? 0 : bar ? 4 : 10}" width="${drop ? 3 : 1.5}" height="${drop ? 28 : bar ? 20 : 8}" class="${drop ? 'r' : 'p'}"/>`
  }
  return out
}
function soundTrace() {
  let d = 'M0 26', x = 0
  while (x < W) {
    const quiet = rnd() < .1, w = quiet ? 10 + rnd() * 18 : 4
    d += ` L${f1(x)} ${quiet ? 26 : f1(26 - 6 - rnd() * 18)}`
    x += w
  }
  return `<path d="${d} L${W} 26 Z" class="p"/>`
}
const svg = (inner: string) => `<svg viewBox="0 0 ${W} ${H}" preserveAspectRatio="none" aria-hidden="true">${inner}</svg>`
// the readout: what the agent reads about a film before it cuts (one 6-minute interview, with a song under it)
const log = [
  { k: 'Words', trace: svg(wordsTrace()), found: '2,417 words, each with its start and end', say: 'cut the ums' },
  { k: 'Voices', trace: svg(voicesTrace()), found: 'Two speakers, told apart by voice', say: 'keep only Ravi’s answers' },
  { k: 'Shots', trace: svg(shotsTrace()), found: '38 shots, shaky at 00:52 and 02:10', say: 'lose the shaky bits' },
  { k: 'Subject', trace: svg(subjectTrace()), found: 'A face, followed through 37 of 38 shots', say: 'now a vertical one for Reels' },
  { k: 'Music', trace: svg(musicTrace()), found: '92 BPM, builds at 01:08, drops at 01:24', say: 'cut to the beat after the drop' },
  { k: 'Sound', trace: svg(soundTrace()), found: '−19 LUFS, 14 pauses over half a second', say: 'tighten the pauses' },
]

// the jobs people come for: what you say, what AgentShot does, what comes out. Each caption says what the clip really is.
// Product demos first: filming a product in your own browser is what nothing else does.
const ex = (id: string) => motion.find(m => m.id === id)!
const films = [
  { job: 'Product demos', tone: 'sky', from: 'From a URL', k: 'Your product’s URL', prompt: 'A walkthrough of app.example.com: sign up and make a first project.', steps: ['Tried the product first, without filming', 'Showed a storyboard: each step and what the voice will say', 'Filmed one take in your Chrome, where you’re already signed in', 'Cut the waiting, zoomed into each click, held each step for its line'], video: `/motion/robj3d3-b18fad.mp4`, poster: '/motion/robj3d3-b18fad.jpg', shape: 'wide', cap: `A product film from the gallery, by @${ex('robj3d3-b18fad').handle}` },
  { job: 'Shorts and Reels', tone: 'pink', from: 'From any video', k: 'A vertical Short', prompt: 'Make it a Short with a caption.', steps: ['Found the subject and tracked him through the shot', 'Reframed 16:9 to 9:16 so he never leaves the frame', 'Timed the caption to the moment and burned it in', 'Exported 1080 × 1920 for Shorts, Reels and TikTok'], video: '/demo/short.mp4', poster: '/demo/short.webp', shape: 'tall', cap: 'The after, rendered by the engine AgentShot drives' },
  { job: 'Your footage, polished', tone: 'coral', from: 'From your footage', k: 'Your footage', prompt: 'Make it cinematic, and put his name on screen.', steps: ['Measured the clip: one shot, one face, followed in every frame', 'Graded it and set it in a widescreen letterbox', 'Set his name in real type you can still drag and retype', 'Came back as a before and after, to keep or send back'], video: '/demo/cinema.mp4', poster: '/demo/cinema.webp', shape: 'wide', cap: 'The after, rendered by the engine AgentShot drives' },
  { job: 'Motion graphics', tone: 'violet', from: 'From nothing at all', k: 'Nothing at all', prompt: `Use the “${ex('tdinh-me-815acb').title}” example, but reveal @logo.png in our colours.`, steps: ['Read the example’s prompt and studied the film', 'Asked for what it needed: the logo, two colours, a track', 'Showed a storyboard before making a frame', 'Built real motion graphics, so a note changes one scene, not all of them'], video: `/motion/tdinh-me-815acb.mp4`, poster: '/motion/tdinh-me-815acb.jpg', shape: 'wide', cap: `The example it starts from, by @${ex('tdinh-me-815acb').handle}` },
]

const notes = [
  { you: 'cut the ums, and the bit where I lose my train of thought', did: 'Cut 9 fillers and the restart at 0:42, each in the quiet before the next word.', at: '2:31 → 2:12' },
  { you: 'blur this number plate', did: 'Blurred that box from 0:18 to 0:24. The rest of the shot is untouched.', at: 'box · 0:18' },
  { you: 'put my name on screen when I introduce myself', did: 'Lower third at 0:04, in real type you can drag or retype on the picture.', at: 'on the word “I’m”' },
  { you: 'quiet music under the whole thing', did: 'The music loops to 2:12 and dips under every sentence. You hear the mix before it renders.', at: '0:00 → end' },
  { you: 'now a vertical one for Shorts, captions burned in', did: 'Same film at 9:16, the crop following whoever’s in frame.', at: '9:16' },
]

const faqs = [
  { q: 'Does my video get uploaded anywhere?', a: `No. Editing, transcription and analysis run on your computer. The AI model reads text and a few still frames it asks to look at. It never gets the video file. AgentShot Cloud and cloud workers are there if you choose them, and only then does a project leave your computer.` },
  PRICING_FAQS[0],
  { q: 'Do I need to know video editing?', a: `No. If you can describe what you want to a person, you can direct AgentShot. If you do know editing, you’ll get there faster: it understands “J-cut”, “punch in” and “duck the music”.` },
  { q: 'Which AI does it use?', a: `Your pick, per project. Bring a Claude, Gemini or OpenAI key, or any OpenAI- or Anthropic-compatible endpoint, or sign in for the AgentShot key. Your keys stay in your system’s keychain, and the agent’s sandbox can’t read them.` },
  { q: 'Can I still edit by hand?', a: `Yes. It edits a timeline, not your pixels. Cuts, titles, captions and music stay editable, so you can drag, resize or retype anything on the picture afterwards.` },
  { q: 'Will it mess up my film?', a: `It can’t. Nothing is overwritten. Every change comes back as a new version to compare, and every version you keep is one click away.` },
  PRICING_FAQS[1],
  { q: 'What can’t it do yet?', a: `Hand the cut to Premiere, Resolve or Final Cut, publish straight to YouTube, or generate camera shots. Those are on the <a href="${gh}/blob/main/ROADMAP.md">public roadmap</a>.` },
  { q: 'Who makes it?', a: `Hormuz Labs, in the open. Issues and pull requests are welcome on <a href="${gh}">GitHub</a>. For anything else, write to <a href="mailto:support@agentshot.si">support@agentshot.si</a>.` },
]
---
<Base title={title} description={description}>
  <Fragment slot="head">
    <link rel="preload" href="/demo/before.webp" as="image" type="image/webp" />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: 'AgentShot', applicationCategory: 'MultimediaApplication',
      operatingSystem: 'macOS, Windows, Linux', offers: OFFERS, url: 'https://agentshot.si/', description: PLAN_SUMMARY,
      downloadUrl: `${gh}/releases/latest`, softwareVersion: version, license: `${gh}/blob/main/LICENSE`,
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org', '@type': 'VideoObject', name: 'AgentShot: give notes, get cuts',
      description: 'An 88-second film about AgentShot, the open-source video editor you talk to.',
      thumbnailUrl: 'https://agentshot.si/film/poster.jpg', contentUrl: 'https://agentshot.si/film/manul.mp4', uploadDate: '2026-10-07', duration: 'PT1M28S',
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org', '@type': 'FAQPage',
      mainEntity: faqs.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, '') } })),
    })} />
  </Fragment>

  <main>
    <section class="hero" aria-label="AgentShot" data-hero>
      <div class="wrap hero-in">
        <Fragment set:html={reel({ cls: 'hs hs-reel', depth: 0.5 })} />
        <Fragment set:html={clips({ cls: 'hs hs-clips', depth: 0.35 })} />
        <Fragment set:html={play({ cls: 'hs hs-play', depth: 0.6 })} />
        <Fragment set:html={spark({ cls: 'hs hs-spark', depth: 0.8 })} />
        <Fragment set:html={spark4({ cls: 'hs hs-spark4', depth: 0.45, ramp: 'cool' })} />
        <div class="hero-title">
          <span class="tag">the open-source video editor you talk to</span>
          <h1>Give notes. <span class="cuts">Get cuts.</span></h1>
          <span class="hero-sticker"><span class="sticker sticker-pink drag">no timeline required</span></span>
        </div>
        <div class="hero-side">
          <p class="lede">Say what you want, point at the frame, and keep the cut or send it back. It edits on your own computer.</p>
          <div class="hero-cta magnetic" data-hero-cta>
            <Cta />
          </div>
          <p class="reassure for-computer">Free and open source. Your footage stays on your computer.<span class="mac-only"> <a href={MAC_INTEL} data-dl="mac">Intel Mac?</a></span></p>
          <p class="reassure for-phone">It runs on Mac, Windows and Linux, so send yourself the link. Free and open source.</p>
          <button class="film-link" type="button" data-film><span class="pl" aria-hidden="true"></span>Watch the film <span class="mono dur">1:28</span></button>
        </div>
      </div>
      <div class="wrap stage" id="try">
        <Demo />
        <p class="credit">Try it. Each after is a real render of one clip. Timofey the Pallas’s cat, Moscow Zoo, CC BY 4.0.</p>
      </div>
    </section>

    <ul class="facts wrap" role="list">
      <li data-reveal style="--c: var(--yellow)"><b>$0</b><span>with your own Claude, Gemini or GPT key</span></li>
      <li data-reveal style="--c: var(--mint)"><b>0 uploads</b><span>editing and transcription run on your computer</span></li>
      <li data-reveal style="--c: var(--pink)"><b>Every version</b><span>kept. Nothing is ever overwritten</span></li>
      <li data-reveal style="--c: var(--sky)"><b>All the code</b><span>on GitHub under the GPL</span></li>
    </ul>

    <section class="sec wrap statement" aria-label="Why AgentShot">
      <Fragment set:html={wave({ cls: 'st-wave', depth: 0.4 })} />
      <Fragment set:html={diamond({ cls: 'st-diamond', depth: 0.7 })} />
      <span class="tag">why AgentShot</span>
      <p data-fill>Editing a video is thousands of small decisions made with a mouse. AgentShot keeps the decisions and drops the mouse work. You watch your film, say what should change, and it changes it.</p>
    </section>

    <section class="slide" data-slide aria-label="What people make with it">
      <div class="slide-row" data-track>
        <span class="sw">Product demos</span><Fragment set:html={spark({ cls: 'slide-shape', depth: 0 })} />
        <span class="sw">Shorts</span><Fragment set:html={play({ cls: 'slide-shape', depth: 0, ramp: 'cool' })} />
        <span class="sw">Clean takes</span><Fragment set:html={spark4({ cls: 'slide-shape', depth: 0 })} />
        <span class="sw">Captions</span><Fragment set:html={note({ cls: 'slide-shape', depth: 0, ramp: 'hot' })} />
        <span class="sw">Motion graphics</span>
      </div>
      <div class="slide-row outline" data-track2 aria-hidden="true">
        <span>cut the ums</span><i>✦</i><span>blur this</span><i>✦</i><span>make it vertical</span><i>✦</i><span>music under it</span><i>✦</i><span>name on screen</span><i>✦</i><span>tighter</span>
      </div>
    </section>

    <section class="sec wrap" id="make">
      <div class="sec-head">
        <span class="tag">what it makes</span>
        <h2>Pick the job. <span class="grad">Say it your way.</span></h2>
        <p>Bring footage, a URL, or nothing at all. Each of these started as one sentence.</p>
      </div>
      <div class="jobs">
        {films.map((f, i) => (
          <article class={`job job-${f.tone}`} data-job style={`--i: ${i}`}>
            <div class="job-in">
              <div class="job-copy">
                <span class={`sticker sticker-${f.tone === 'sky' ? 'mint' : f.tone}`}>{f.from}</span>
                <h3>{f.job}</h3>
                <q>{f.prompt}</q>
                <ol>{f.steps.map(st => <li>{st}</li>)}</ol>
              </div>
              <figure class={f.shape}>
                <video data-src={f.video} poster={f.poster} muted loop playsinline preload="none" aria-label={`Result: ${f.job}`}></video>
                <figcaption>{f.cap}</figcaption>
              </figure>
            </div>
          </article>
        ))}
      </div>

      <div class="gallery-head" id="examples">
        <h3><span class="big" data-count="233">233</span> examples ship in the app, each with the prompt that made it.</h3>
        <p>Pick one, say what yours is about, and AgentShot makes it the same way. Click to see the prompt.</p>
      </div>
      <ul class="reels" role="list">
        {motion.map((m, i) => (
          <li data-reveal>
            <button type="button" data-ex={i} aria-label={`Play “${m.title}” by @${m.handle}`}>
              <video data-src={`/motion/${m.id}.mp4`} poster={`/motion/${m.id}.jpg`} muted loop playsinline preload="none" width="768" height="432" aria-hidden="true"></video>
              <span><span>@{m.handle}</span><span class="mono">{clock(m.duration)}</span></span>
            </button>
          </li>
        ))}
      </ul>
      <p class="fine">Made with Claude by the people credited, collected by <a href="https://prompt-motion.com">prompt-motion.com</a>.</p>
    </section>

    <section class="sec wrap" id="notes">
      <Fragment set:html={note({ cls: 'notes-shape', depth: 0.5 })} />
      <div class="sec-head">
        <span class="tag">how you edit</span>
        <h2>Talk to it like an editor <span class="grad">in the room.</span></h2>
        <p>Every word you recorded is timed, so a note lands exactly where you meant it. A real session reads like this.</p>
      </div>
      <ol class="session" role="list" data-chat>
        {notes.map((n, i) => (
          <li style={`--c: var(--${['pink', 'sky', 'yellow', 'mint', 'violet'][i % 5]})`}>
            <q>{n.you}</q>
            <p>{n.did}</p>
            <span class="mono">{n.at}</span>
          </li>
        ))}
      </ol>
      <div class="point">
        <figure data-reveal><img src="/shots/inline.webp" width="1600" height="955" loading="lazy" alt="AgentShot: a note boxed on the frame says “make the name bigger”, with the conversation on the left and the proposed cut, Before / After, Reject and Accept above the film" /></figure>
        <div data-reveal>
          <h3>Point instead of describing.</h3>
          <dl>
            <div><dt><kbd>B</kbd></dt><dd>Box anything on the picture</dd></div>
            <div><dt><kbd>N</kbd></dt><dd>Mark a moment</dd></div>
            <div><dt>Drag</dt><dd>Across the timeline for a range</dd></div>
          </dl>
          <p>A message box opens right there, already tied to that spot and time.</p>
        </div>
      </div>
    </section>

    <section class="sec wrap" id="how">
      <div class="sec-head">
        <span class="tag">how it works</span>
        <h2>It reads your film <span class="grad">before it touches it.</span></h2>
        <p>A language model can’t watch video. So AgentShot measures your footage on your computer, and the model reads the result. That’s why “drop the second take” lands on the right syllable.</p>
      </div>
      <div class="tracks" role="table" aria-label="What AgentShot measures in a 6-minute interview, and what that lets you say">
        <div class="track head" role="row">
          <span role="columnheader">Track</span>
          <span role="columnheader">One 6-minute interview</span>
          <span role="columnheader">So you can say</span>
        </div>
        {log.map((r, i) => (
          <div class="track" role="row" style={`--c: var(--${['yellow', 'pink', 'sky', 'mint', 'violet', 'coral'][i]})`}>
            <span class="k" role="rowheader">{r.k}</span>
            <div role="cell"><span class="trace" set:html={r.trace} /><p class="mono">{r.found}</p></div>
            <q role="cell">{r.say}</q>
          </div>
        ))}
      </div>
    </section>

    <section class="sec wrap" id="compare">
      <div class="sec-head">
        <span class="tag">compared</span>
        <h2>Not a timeline to operate. <span class="grad">Not a slot machine.</span></h2>
      </div>
      <div class="cmp" role="table" aria-label="AgentShot compared with timeline editors, video as code, and AI generators" data-reveal>
        <div class="row th" role="row"><span role="columnheader"></span><span role="columnheader">Timeline editors<small>Premiere, Final Cut, Resolve, CapCut</small></span><span role="columnheader">Video as code<small>HyperFrames, Remotion</small></span><span role="columnheader">AI generators<small>Runway, Sora, Veo</small></span><span role="columnheader" class="us">AgentShot</span></div>
        <div class="row" role="row"><span role="rowheader">You</span><span role="cell" data-h="Timeline editors">operate it, cut by cut</span><span role="cell" data-h="Video as code">describe it, read code</span><span role="cell" data-h="AI generators">prompt, hope, re-roll</span><span role="cell" data-h="AgentShot" class="us">say it, point at it</span></div>
        <div class="row" role="row"><span role="rowheader">You look at</span><span role="cell" data-h="Timeline editors">a timeline</span><span role="cell" data-h="Video as code">a terminal</span><span role="cell" data-h="AI generators">a prompt box</span><span role="cell" data-h="AgentShot" class="us">your film, before and after</span></div>
        <div class="row" role="row"><span role="rowheader">Your footage</span><span role="cell" data-h="Timeline editors">yours</span><span role="cell" data-h="Video as code">yours, plus coded layers</span><span role="cell" data-h="AI generators">swapped for generated frames</span><span role="cell" data-h="AgentShot" class="us">yours, on your computer</span></div>
        <div class="row" role="row"><span role="rowheader">Undo</span><span role="cell" data-h="Timeline editors">Ctrl-Z, until it isn’t</span><span role="cell" data-h="Video as code">git, if you use it</span><span role="cell" data-h="AI generators">start over</span><span role="cell" data-h="AgentShot" class="us">every version, kept</span></div>
        <div class="row" role="row"><span role="rowheader">Costs</span><span role="cell" data-h="Timeline editors">a subscription, mostly</span><span role="cell" data-h="Video as code">free, plus your agent</span><span role="cell" data-h="AI generators">credits</span><span role="cell" data-h="AgentShot" class="us">free with your key</span></div>
      </div>
    </section>

    <section class="sec wrap yours" id="yours">
      <Fragment set:html={reel({ cls: 'yours-reel', depth: 0.4, ramp: 'cool' })} />
      <div data-reveal>
        <span class="tag">private by design</span>
        <h2>Your footage <span class="grad">stays yours.</span></h2>
        <ul role="list">
          <li><b>No upload queue, no cloud project.</b> Editing, transcription and analysis run on your computer.</li>
          <li><b>The AI model sees text and still frames.</b> It never sees the video file.</li>
          <li><b>Your keys stay in your system’s keychain.</b> The agent’s sandbox can’t read them.</li>
          <li><b>Crash reports and usage statistics are off</b> until you tick them. <a href={`${gh}/blob/main/telemetry/README.md`}>See exactly what is sent.</a></li>
        </ul>
      </div>
      <div class="phones">
        <div class="phone-copy" data-reveal>
          <h3>Direct it from your phone.</h3>
          <p>A remote for the editor on your computer. Mark a moment, box the picture, say the change, and keep it with your thumb. In Google Play testing now.</p>
        </div>
        <img data-reveal src="/phone/film.webp" width="415" height="801" loading="lazy" alt="The film full screen on the phone, with Note, Box, Range and Timeline down the right" />
        <img data-reveal src="/phone/conversation.webp" width="415" height="801" loading="lazy" alt="A project on the phone: the conversation, with the agent’s question as buttons" />
      </div>
    </section>

    <Pricing />

    <section class="sec wrap" id="get">
      <Fragment set:html={clips({ cls: 'get-clips', depth: 0.4 })} />
      <div class="sec-head">
        <span class="tag">install</span>
        <h2>Install it. <span class="grad">Give it a note.</span></h2>
        <p class="for-phone">AgentShot runs on a computer. Send yourself the link and open it there.</p>
        <p class="for-computer">Open it, sign in for {fmt(STARTER_CREDITS)} free credits or paste your own key, and drop in a video. A short guided start takes you to your first note.</p>
      </div>
      <div class="phone-get for-phone"><Cta /></div>
      <div class="oses">
        <article data-os-col="mac" data-reveal style="--c: var(--pink)">
          <h3>macOS</h3>
          <p class="req">macOS 12+. Signed and notarized.</p>
          <a class="btn get" href={MAC_ARM}>Apple silicon .dmg</a>
          <div class="line"><code>{BREW}</code><button class="copy" data-copy={BREW}>Copy</button></div>
          <p class="more"><a href={MAC_INTEL}>Intel Mac .dmg</a></p>
        </article>
        <article data-os-col="win" data-reveal style="--c: var(--sky)">
          <h3>Windows</h3>
          <p class="req">Windows 10 (1903+) and 11, 64-bit.</p>
          <a class="btn get" href={WINDOWS}>Setup .exe</a>
          <p class="more">No Node, Python, FFmpeg or developer tools needed. It updates itself. If SmartScreen asks once: More info, then Run anyway.</p>
        </article>
        <article data-os-col="linux" data-reveal style="--c: var(--mint)">
          <h3>Linux</h3>
          <p class="req">Debian, Ubuntu and AppImage.</p>
          <a class="btn get" href={DEB}>x64 .deb</a>
          <div class="line"><code>curl -fsSL https://apt.agentshot.si/… &amp;&amp; sudo apt install manul</code><button class="copy" data-copy={APT}>Copy</button></div>
          <p class="more"><a href={DEB_ARM}>ARM .deb</a> · <a href={APPIMAGE}>AppImage x64</a> · <a href={APPIMAGE_ARM}>AppImage ARM</a></p>
        </article>
      </div>
      <div class="agent" data-reveal>
        <div>
          <h3>Or let your coding agent install it.</h3>
          <p>Paste this into Claude Code, Cursor or Codex.</p>
        </div>
        <button class="btn ghost sm" data-copy={AGENT_PROMPT}>Copy the prompt</button>
      </div>
    </section>

    <section class="sec wrap" id="source">
      <div class="source" data-reveal>
        <Fragment set:html={spark({ cls: 'source-spark', depth: 0.6 })} />
        <div>
          <h2>Read the whole thing.</h2>
          <p>The agent, the editor and its 12 craft skills are on GitHub under the GPL. Skills are plain files you can change. Point it at any OpenAI- or Anthropic-compatible endpoint, local servers included. If you like where it’s going, a star helps other people find it.</p>
        </div>
        <a class="btn star magnetic" href={gh}>Star on GitHub</a>
      </div>
    </section>

    <section class="sec wrap faq" id="faq">
      <span class="tag">questions</span>
      <h2>Questions</h2>
      <div class="qs">{faqs.map(f => <details><summary>{f.q}</summary><p set:html={f.a} /></details>)}</div>
    </section>

    <section class="last">
      <div class="wrap last-film">
        <video id="cat" src="/timofey.mp4" poster="/timofey.webp" width="960" height="720" muted loop playsinline preload="none" aria-label="Timofey, a Pallas's cat, staring flatly at the camera"><track kind="captions" src="/captions/silent.vtt" srclang="en" label="No sound" /></video>
        <p class="caption"><mark>He’s waiting for your notes.</mark></p>
        <Fragment set:html={play({ cls: 'last-play', depth: 0.5 })} />
        <Fragment set:html={spark4({ cls: 'last-spark', depth: 0.7, ramp: 'cool' })} />
      </div>
      <div class="last-cta magnetic"><Cta /></div>
    </section>
  </main>

  <dialog class="player" id="film" aria-label="AgentShot, the film">
    <video id="film-v" controls playsinline preload="none" poster="/film/poster.jpg" width="1920" height="1080">
      <source src="/film/manul.mp4" type="video/mp4" />
      <track kind="captions" src="/captions/film.vtt" srclang="en" label="English" />
    </video>
    <button class="close" type="button" aria-label="Close the film">×</button>
  </dialog>

  <dialog class="player ex" id="ex" aria-label="A motion example">
    <video id="ex-v" controls playsinline preload="none" width="1920" height="1080"></video>
    <div class="ex-info">
      <div><p class="ex-title" id="ex-title"></p><p class="ex-by">by <a id="ex-who"></a> · <a id="ex-post">View post</a></p></div>
      <details><summary>The prompt that made it</summary><pre id="ex-prompt"></pre></details>
    </div>
    <button class="close" type="button" aria-label="Close">×</button>
  </dialog>
  <script type="application/json" id="ex-data" set:html={JSON.stringify(motion.map(m => ({ ...m, video: `${media}/${m.id}.mp4`, poster: `/motion/${m.id}.jpg` })))} />
</Base>

<style>
  /* the hero: the promise and the button over floating shapes, then the product itself */
  .hero { position: relative; padding-top: clamp(28px, 5vh, 64px); isolation: isolate; }
  .hero-in { position: relative; z-index: 1; display: grid; grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr); gap: 18px 56px; align-items: end; }
  .hero-title { position: relative; }
  /* sized so "Give notes." always fits its column on one line: two lines at every width, never three */
  h1 { font-size: min(8.2vw, 17vh, 118px); line-height: .9; font-weight: 800; letter-spacing: -.045em; }
  h1 :global(.line) { padding-bottom: .04em; }
  .cuts { color: var(--yellow); }
  .hero-sticker { position: absolute; right: 2%; bottom: -.2em; z-index: 2; font-size: clamp(16px, 1.9vw, 26px); }
  .hero-sticker .sticker { cursor: grab; }
  .lede { font-size: clamp(19px, 1.7vw, 24px); line-height: 1.35; }
  .hero-cta { margin-top: 20px; }
  .film-link { display: inline-flex; align-items: center; gap: 10px; margin-top: 14px; padding: 6px 14px 6px 6px; border: 1px solid var(--line); border-radius: 999px; background: var(--bg-2); font-size: 16px; font-weight: 600; cursor: pointer; transition: background .15s; }
  .film-link:hover { background: var(--bg-3); }
  .pl { width: 30px; height: 30px; border-radius: 50%; background: var(--film); -webkit-mask: radial-gradient(circle, #000 64%, transparent 65%); mask: radial-gradient(circle, #000 64%, transparent 65%); position: relative; }
  .pl::after { content: ''; position: absolute; inset: 9px 8px 9px 11px; background: #fff; clip-path: polygon(0 0, 100% 50%, 0 100%); }
  .dur { font-size: 14px; color: var(--ink-3); }
  .reassure { margin-top: 12px; font-size: 15px; color: var(--ink-2); }
  .for-phone { display: none; }
  :global([data-os='phone']) .for-phone { display: block; }
  :global([data-os='phone']) .for-computer { display: none; }
  .stage { position: relative; z-index: 1; width: min(100% - 32px, max(800px, (100vh - 370px) * 2.25)); margin: clamp(28px, 4vh, 48px) auto 0; }
  .stage :global(#demo) { border-radius: var(--r); overflow: hidden; box-shadow: 0 40px 120px -30px rgba(123, 97, 255, .45), 0 0 0 1px var(--line); }
  .credit { margin-top: 12px; font-size: 13.5px; color: var(--ink-3); }

  :global(.hs) { z-index: 0; }
  /* around the headline, in the space the words leave: above the side copy, after "notes.", under the demo's corner */
  :global(.hs-reel) { width: clamp(96px, 9vw, 136px); top: -12%; left: 50%; }
  :global(.hs-play) { width: clamp(56px, 5vw, 88px); top: 48%; left: 54%; }
  :global(.hs-spark) { width: clamp(40px, 3.6vw, 60px); top: -16%; left: 41%; }
  :global(.hs-spark4) { width: clamp(34px, 3vw, 54px); bottom: -4%; left: 86%; }
  /* a narrow laptop: the side column runs taller than the headline, so centre the two and keep the shapes off the header */
  @media (min-width: 901px) and (max-width: 1180px) {
    .hero-in { gap: 18px 36px; align-items: center; }
    :global(.hs-reel) { top: 0; left: 46%; }
    :global(.hs-spark) { top: 2%; left: 38%; }
  }
  :global(.hs-clips) { width: clamp(120px, 12vw, 200px); bottom: -70%; right: -4%; }

  .facts { list-style: none; margin-top: clamp(48px, 7vw, 88px); padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }
  .facts li { position: relative; display: grid; gap: 4px; padding: 22px 22px 24px; border-radius: var(--r); background: var(--bg-2); overflow: hidden; }
  .facts li::before { content: ''; position: absolute; inset: 0 0 auto; height: 4px; background: var(--c); }
  .facts b { font-size: clamp(26px, 2.6vw, 34px); line-height: 1.05; font-weight: 800; letter-spacing: -.03em; color: var(--c); }
  .facts span { font-size: 15px; line-height: 1.35; color: var(--ink-2); }

  /* a statement that lights up as you read it */
  .statement { position: relative; }
  .statement p { position: relative; z-index: 1; max-width: 1120px; font-size: clamp(32px, 4.6vw, 66px); line-height: 1.08; font-weight: 800; letter-spacing: -.03em; }
  :global(.st-wave) { width: clamp(180px, 22vw, 320px); right: -2%; top: 18%; }
  :global(.st-diamond) { width: clamp(50px, 5vw, 80px); left: -1%; bottom: -14%; }

  /* the jobs, sliding past */
  .slide { position: relative; overflow: hidden; padding-block: clamp(64px, 9vw, 120px); }
  .slide-row { display: flex; align-items: center; gap: clamp(20px, 3vw, 44px); width: max-content; padding-inline: 4vw; white-space: nowrap; }
  .sw { font-size: clamp(64px, 13vw, 220px); font-weight: 800; letter-spacing: -.05em; line-height: .95; }
  .slide-row :global(.slide-shape) { position: relative; flex: none; width: clamp(64px, 9vw, 150px); }
  .outline { margin-top: 18px; gap: 24px; font-size: clamp(30px, 5vw, 76px); font-weight: 800; letter-spacing: -.03em; color: transparent; -webkit-text-stroke: 1.5px var(--ink-3); }
  .outline i { font-style: normal; color: var(--pink); -webkit-text-stroke: 0; font-size: .5em; }

  /* the jobs, as cards that stack as you scroll */
  .jobs { display: grid; gap: 28px; }
  .job { position: sticky; top: calc(84px + var(--i) * 16px); border-radius: calc(var(--r) + 8px); transform-origin: 50% 0; }
  .job-in { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.35fr); gap: clamp(24px, 4vw, 56px); align-items: center; padding: clamp(22px, 3.4vw, 48px); border-radius: inherit; background: var(--bg-2); border: 1px solid var(--line); }
  .job-sky .job-in { background: radial-gradient(120% 140% at 0% 0%, color-mix(in srgb, var(--sky) 30%, var(--bg-2)), var(--bg-2) 60%); }
  .job-pink .job-in { background: radial-gradient(120% 140% at 0% 0%, color-mix(in srgb, var(--pink) 30%, var(--bg-2)), var(--bg-2) 60%); }
  .job-coral .job-in { background: radial-gradient(120% 140% at 0% 0%, color-mix(in srgb, var(--coral) 30%, var(--bg-2)), var(--bg-2) 60%); }
  .job-violet .job-in { background: radial-gradient(120% 140% at 0% 0%, color-mix(in srgb, var(--violet) 36%, var(--bg-2)), var(--bg-2) 60%); }
  .job .sticker { font-size: 15px; }
  .job h3 { margin-top: 18px; font-size: clamp(32px, 4vw, 58px); letter-spacing: -.035em; }
  .job q { display: block; margin-top: 14px; font-size: clamp(19px, 1.8vw, 24px); line-height: 1.25; font-weight: 600; color: var(--ink); }
  .job ol { margin: 20px 0 0; padding: 0; list-style: none; counter-reset: s; }
  .job li { counter-increment: s; display: flex; gap: 12px; padding: 8px 0; border-top: 1px solid color-mix(in srgb, var(--ink) 12%, transparent); color: var(--ink-2); font-size: 15.5px; line-height: 1.4; }
  .job li::before { content: counter(s); flex: none; width: 22px; height: 22px; border-radius: 50%; display: grid; place-items: center; background: var(--ink); color: var(--bg); font: 600 12px/1 var(--mono); margin-top: 1px; }
  .job figure { margin: 0; }
  .job video { width: 100%; border-radius: 16px; background: #000; }
  .job .tall video { width: auto; max-height: 480px; margin-inline: auto; }
  .job figcaption { margin-top: 8px; font-size: 13.5px; color: var(--ink-3); }

  .gallery-head { margin: clamp(80px, 10vw, 140px) 0 24px; max-width: 900px; }
  .gallery-head h3 { font-size: clamp(26px, 3vw, 40px); }
  .big { display: inline-block; min-width: 2.2ch; font-size: 1.8em; vertical-align: -.1em; background: var(--film); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .gallery-head p { margin-top: 12px; color: var(--ink-2); }
  .reels { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; }
  .reels button { position: relative; display: block; width: 100%; padding: 0; border: 0; border-radius: 16px; overflow: hidden; background: #000; cursor: pointer; transition: transform .25s cubic-bezier(.2, .9, .3, 1.3); }
  .reels button:hover { transform: scale(1.025) rotate(-.4deg); }
  .reels video { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; }
  .reels button > span { position: absolute; inset: auto 8px 8px; display: flex; justify-content: space-between; padding: 6px 10px; border-radius: 999px; background: rgba(13, 12, 17, .78); backdrop-filter: blur(6px); font-size: 13.5px; color: var(--ink); text-align: left; }
  .fine { margin-top: 14px; font-size: 14px; color: var(--ink-3); }

  /* a session, as a conversation */
  :global(.notes-shape) { width: clamp(70px, 8vw, 130px); right: 4%; top: 6%; }
  .session { list-style: none; margin: 0; padding: 0; display: grid; gap: 22px; }
  .session li { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 10px 24px; align-items: start; }
  .session q { grid-column: 2; justify-self: end; max-width: 100%; padding: 16px 22px; border-radius: 24px 24px 6px 24px; background: var(--c); color: var(--on-yellow); font-size: clamp(19px, 2vw, 27px); line-height: 1.18; font-weight: 700; letter-spacing: -.015em; quotes: none; }
  .session p { position: relative; grid-column: 1 / span 1; grid-row: 2; margin-left: 42px; padding: 14px 18px; border-radius: 24px 24px 24px 6px; background: var(--bg-2); border: 1px solid var(--line); color: var(--ink-2); }
  /* AgentShot's side of the conversation carries its face, so it's clear who is answering */
  .session p::before { content: ''; position: absolute; left: -43px; bottom: -1px; width: 32px; height: 32px; border-radius: 50%; background: var(--bg-3) url('/icon-56.png') center / cover; }
  .session .mono { grid-column: 2; grid-row: 2; align-self: center; font-size: 13.5px; color: var(--ink-3); }

  .point { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); gap: 44px; align-items: center; margin-top: 64px; }
  .point figure { margin: 0; }
  .point img { border-radius: var(--r); box-shadow: 0 30px 90px -30px rgba(255, 79, 176, .45); }
  .point dl { margin: 18px 0; }
  .point dl div { display: flex; gap: 16px; align-items: center; padding: 11px 0; border-bottom: 1px solid var(--line); }
  .point dt { flex: none; min-width: 52px; font-weight: 700; }
  .point dd { margin: 0; color: var(--ink-2); }
  kbd { display: inline-grid; place-items: center; width: 34px; height: 34px; border-radius: 10px; background: var(--yellow); color: var(--on-yellow); box-shadow: 0 3px 0 #b39c00; font: 600 15px/1 var(--mono); }
  .point p { color: var(--ink-2); }

  /* the measurements, drawn as the tracks of a timeline, each in its colour */
  .tracks { border-radius: var(--r); background: var(--bg-2); padding: 6px 24px; }
  .track { display: grid; grid-template-columns: 100px minmax(0, 1.6fr) minmax(0, 1fr); gap: 8px 28px; align-items: center; padding: 16px 0; border-bottom: 1px solid var(--line); }
  .track:last-child { border-bottom: 0; }
  .track.head { padding: 12px 0; font: 500 13px/1.2 var(--mono); color: var(--ink-3); }
  .k { font-weight: 800; font-size: 18px; color: var(--c); }
  .trace { display: block; height: 28px; }
  .trace :global(svg) { display: block; width: 100%; height: 100%; }
  .trace :global(.p) { fill: color-mix(in srgb, var(--c) 45%, var(--bg-3)); }
  .trace :global(.q) { fill: var(--ink); }
  .trace :global(.r) { fill: var(--c); }
  .trace :global(.b) { fill: var(--bg-3); }
  .trace :global(.rl) { fill: none; stroke: var(--c); stroke-width: 1.6; vector-effect: non-scaling-stroke; }
  .track p { margin-top: 6px; font-size: 13.5px; color: var(--ink-2); }
  .track q { font-size: 20px; line-height: 1.2; font-weight: 700; }

  .cmp { border-radius: var(--r); background: var(--bg-2); overflow: hidden; }
  .row { display: grid; grid-template-columns: 120px repeat(3, minmax(0, 1fr)) minmax(0, 1.1fr); border-bottom: 1px solid var(--line); }
  .row:last-child { border-bottom: 0; }
  .row > span { padding: 16px 16px; line-height: 1.3; color: var(--ink-2); }
  .row > [role='rowheader'] { color: var(--ink-3); font-size: 15px; }
  .row .us { background: color-mix(in srgb, var(--violet) 16%, var(--bg-2)); color: var(--ink); font-weight: 700; }
  .th .us { background: var(--film); color: var(--on-yellow); font-weight: 800; }
  .th > span { font-weight: 700; color: var(--ink); }
  .th small { display: block; margin-top: 3px; font-size: 13px; font-weight: 400; color: var(--ink-3); }

  .yours { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 56px; align-items: start; }
  :global(.yours-reel) { width: clamp(90px, 10vw, 150px); left: 30%; top: auto; bottom: -30px; }
  .yours ul { list-style: none; margin: 28px 0 0; padding: 0; }
  .yours li { padding: 14px 0; border-bottom: 1px solid var(--line); color: var(--ink-2); }
  .yours b { color: var(--ink); }
  .yours h2 { font-size: clamp(42px, 6vw, 88px); }
  .yours > div { position: relative; z-index: 1; }
  .phones { position: relative; z-index: 1; display: grid; grid-template-columns: 1fr 1fr; gap: 14px 22px; }
  .phone-copy { grid-column: 1 / -1; }
  .phone-copy p { margin-top: 10px; color: var(--ink-2); }
  /* each screenshot sits in a phone's bezel, the pair leaning apart, so two different screens read as two phones */
  .phones img { width: 100%; border: 7px solid #060509; border-radius: 36px; background: #000; box-shadow: 0 0 0 1px var(--line), 0 30px 80px -30px rgba(79, 200, 255, .45); }
  .phones img:nth-of-type(1) { rotate: -2.5deg; }
  .phones img:last-child { margin-top: 44px; rotate: 2.5deg; }

  :global(.get-clips) { width: clamp(110px, 12vw, 190px); right: 2%; top: 4%; }
  .phone-get { margin-bottom: 28px; }
  .oses { position: relative; z-index: 1; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
  .oses article { position: relative; display: flex; flex-direction: column; gap: 12px; min-width: 0; padding: 26px 24px; border-radius: var(--r); background: var(--bg-2); overflow: hidden; }
  .oses article::before { content: ''; position: absolute; inset: 0 0 auto; height: 4px; background: var(--c); }
  .req { font-size: 15px; color: var(--ink-3); }
  .get { width: 100%; background: var(--bg-3); color: var(--ink); }
  .get:hover { background: var(--ink); color: var(--bg); }
  :global([data-os='mac']) [data-os-col='mac'] .get, :global([data-os='win']) [data-os-col='win'] .get, :global([data-os='linux']) [data-os-col='linux'] .get { background: var(--yellow); color: var(--on-yellow); }
  :global([data-os='win']) [data-os-col='win'], :global([data-os='linux']) [data-os-col='linux'] { order: -1; }
  .more { font-size: 14.5px; line-height: 1.45; color: var(--ink-3); }
  .agent { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px 24px; margin-top: 12px; padding: 22px 24px; border-radius: var(--r); background: var(--bg-2); }
  .agent p { margin-top: 4px; color: var(--ink-2); font-size: 15.5px; }

  .source { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 24px 48px; align-items: end; padding: clamp(28px, 5vw, 64px); border-radius: calc(var(--r) + 8px); background: var(--film); color: var(--on-yellow); overflow: hidden; }
  .source h2 { position: relative; }
  .source p { position: relative; margin-top: 16px; max-width: 700px; font-size: 18px; color: color-mix(in srgb, var(--on-yellow) 80%, transparent); }
  .source :global(.source-spark) { width: clamp(80px, 10vw, 150px); right: 18%; top: -10%; opacity: .9; }
  .star { position: relative; background: var(--on-yellow); color: var(--ink); }
  .star:hover { background: #000; }

  .faq h2 { margin-bottom: 36px; }
  .qs { max-width: 920px; display: grid; gap: 10px; }
  .qs details { border-radius: 18px; background: var(--bg-2); padding: 0 22px; transition: background .15s; }
  .qs details[open] { background: var(--bg-3); }
  .qs summary { padding: 20px 0; font-size: 19px; font-weight: 700; cursor: pointer; list-style: none; display: flex; justify-content: space-between; gap: 16px; }
  .qs summary::-webkit-details-marker { display: none; }
  .qs summary::after { content: '+'; flex: none; width: 28px; height: 28px; display: grid; place-items: center; border-radius: 50%; background: var(--yellow); color: var(--on-yellow); font-weight: 800; transition: transform .2s; }
  .qs details[open] summary::after { transform: rotate(45deg); }
  .qs p { padding-bottom: 22px; color: var(--ink-2); }

  .last { padding-top: var(--gap); }
  .last-film { position: relative; }
  .last-film video { width: 100%; height: clamp(380px, 62vh, 680px); object-fit: cover; object-position: center 18%; border-radius: calc(var(--r) + 8px); background: #000; }
  .caption { position: absolute; inset: auto 16px 8%; z-index: 1; text-align: center; font-size: clamp(26px, 5vw, 68px); font-weight: 800; letter-spacing: -.03em; line-height: 1.2; }
  :global(.last-play) { width: clamp(80px, 9vw, 150px); left: -2%; top: -8%; z-index: 2; }
  :global(.last-spark) { width: clamp(50px, 5vw, 90px); right: 1%; bottom: 30%; z-index: 2; }
  .last-cta { display: flex; justify-content: center; padding-top: 32px; }
  :global([data-os='phone']) .last-cta { display: none; }

  .player { width: min(1120px, 100% - 24px); max-height: 92vh; padding: 0; border: 0; border-radius: var(--r); background: #000; color: var(--ink); overflow: auto; }
  .player::backdrop { background: rgba(8, 6, 14, .88); backdrop-filter: blur(6px); }
  .player video { width: 100%; }
  .close { position: absolute; top: 10px; right: 10px; width: 44px; height: 44px; border: 0; border-radius: 50%; background: rgba(0, 0, 0, .75); color: #fff; font-size: 26px; cursor: pointer; }
  .ex-info { padding: 14px 16px 16px; }
  .ex-title { font-size: 20px; font-weight: 700; }
  .ex-by { font-size: 15px; color: var(--ink-2); }
  .ex-info details { margin-top: 10px; }
  .ex-info summary { font-weight: 600; cursor: pointer; }
  .ex-info pre { margin: 10px 0 0; white-space: pre-wrap; font: 500 13.5px/1.5 var(--mono); color: var(--ink-2); }

  @media (max-width: 900px) {
    .hero-in { grid-template-columns: 1fr; }
    .stage { width: calc(100% - 32px); }
    /* two lines, like the desktop, so the product itself starts on the first screen */
    h1 { font-size: min(14.2vw, 26vh, 132px); }
    .slide { padding-block: 40px; }
    :global(.st-wave) { width: 120px; top: calc(var(--gap) - 34px); right: 0; }
    /* one column, in the order it happens: the job, what you say, what comes back, then how it got there */
    .job-in { gap: 0; }
    .job-copy { display: contents; }
    .job .sticker { order: 1; justify-self: start; }
    .job h3 { order: 2; }
    .job q { order: 3; }
    .job figure { order: 4; margin-top: 20px; }
    .job ol { order: 5; margin-top: 16px; }
    .job .tall video { max-height: 400px; }
    .job .tall figcaption { text-align: center; }
    .phones { padding-inline: 8px; }
    :global([data-os='phone']) .oses, :global([data-os='phone']) .agent { display: none; }
    :global([data-os='phone']) .phone-get { margin-bottom: 0; }
    .hero-sticker { position: relative; right: auto; bottom: auto; display: inline-block; margin: 14px 0 0 10px; }
    :global(.hs-clips), :global(.hs-spark4), :global(.hs-play), :global(.hs-spark) { display: none; }
    /* the reel sits in the space "Get cuts." leaves on its line, so the label above keeps its one line */
    :global(.hs-reel) { width: clamp(46px, 14vw, 104px); top: calc(40px + min(14.2vw, 26vh, 132px) * .92); left: auto; right: 0; }
    .hero-title .tag { font-size: 12.5px; }
    .facts { grid-template-columns: 1fr 1fr; }
    .session { gap: 26px; }
    .session li { grid-template-columns: 1fr; gap: 8px; }
    .session q { grid-column: 1; justify-self: end; max-width: 88%; }
    .session p, .session .mono { grid-column: 1; grid-row: auto; }
    .session p { justify-self: start; }
    .session .mono { margin-left: 42px; }
    .point, .yours { grid-template-columns: 1fr; }
    .job { position: relative; top: auto; }
    .job-in { grid-template-columns: 1fr; }
    .reels { grid-template-columns: 1fr 1fr; }
    .track { grid-template-columns: 1fr; }
    .track.head { display: none; }
    .tracks { padding: 6px 18px; }
    .row:not(.th) { grid-template-columns: 1fr; padding: 4px 16px 12px; }
    .row.th { display: none; }
    .row > span { padding: 2px 0; font-size: 15px; }
    /* AgentShot's answer leads each group; the other three sit under it, smaller */
    .row .us { order: -1; margin-bottom: 6px; padding: 9px 12px; border-radius: 10px; font-size: 17px; }
    .row > [role='rowheader'] { order: -2; padding: 14px 0 6px; font-weight: 700; color: var(--ink); font-size: 18px; }
    .row > [role='cell']::before { content: attr(data-h) ': '; color: var(--ink-3); }
    .oses { grid-template-columns: 1fr; }
    .source { grid-template-columns: 1fr; }
    :global(.yours-reel), :global(.get-clips), :global(.notes-shape) { display: none; }
    .hero-cta :global([data-send]), .phone-get :global([data-send]), .last-cta :global([data-send]) { width: 100%; }
    .last-cta :global(.dl-set) { width: 100%; }
    .last-cta { padding-inline: 16px; }
    :global([data-os='phone']) :global(.foot) { padding-bottom: 96px; }
  }
  @media (max-width: 560px) {
    /* small tiles: the credit goes under the film, not over a third of it */
    .reels { gap: 14px 10px; }
    .reels button { border-radius: 0; overflow: visible; background: none; }
    .reels video { border-radius: 12px; background: #000; }
    .reels button > span { position: static; padding: 7px 2px 0; border-radius: 0; background: none; backdrop-filter: none; font-size: 13px; color: var(--ink-2); }
    /* the screenshot is too wide to read at this size, so show the half the paragraph is about: the note on the frame */
    .point img { width: 100%; aspect-ratio: 710 / 955; object-fit: cover; object-position: 100% 0; }
    .facts li { padding: 18px 16px 20px; }
    .phones img:last-child { margin-top: 24px; }
  }
</style>

<script>
  // each job's result plays while it's on screen (and not at all for people who'd rather nothing moved)
  const move = !matchMedia('(prefers-reduced-motion: reduce)').matches
  const jobs = new IntersectionObserver(es => es.forEach(e => {
    const v = e.target as HTMLVideoElement
    if (e.isIntersecting) { if (!v.src) v.src = v.dataset.src!; if (move) v.play().catch(() => {}) } else v.pause()
  }), { rootMargin: '200px 0px', threshold: 0.2 })
  document.querySelectorAll<HTMLVideoElement>('.job video').forEach(v => jobs.observe(v))

  // the film opens in a player over the page
  const film = document.getElementById('film') as HTMLDialogElement, filmV = document.getElementById('film-v') as HTMLVideoElement
  document.querySelectorAll('[data-film]').forEach(b => b.addEventListener('click', () => { film.showModal(); filmV.play().catch(() => {}) }))
  film.querySelector('.close')!.addEventListener('click', () => film.close())
  film.addEventListener('click', e => { if (e.target === film) film.close() })
  film.addEventListener('close', () => filmV.pause())

  // motion examples: small silent previews from this site, fetched a screen early, playing while on screen;
  // a click opens the full one with sound and the prompt behind it
  const warm = new IntersectionObserver(es => es.forEach(e => {
    if (!e.isIntersecting) return
    const v = e.target as HTMLVideoElement
    v.preload = 'auto'; v.src = v.dataset.src!; warm.unobserve(v)
  }), { rootMargin: '120% 60%' })
  const reels = new IntersectionObserver(es => es.forEach(e => {
    const v = e.target as HTMLVideoElement
    if (e.isIntersecting && move) { if (!v.src) v.src = v.dataset.src!; v.play().catch(() => {}) } else v.pause()
  }), { threshold: 0.15 })
  document.querySelectorAll<HTMLVideoElement>('.reels video').forEach(v => { warm.observe(v); reels.observe(v) })
  const exs = JSON.parse(document.getElementById('ex-data')!.textContent!)
  const ex = document.getElementById('ex') as HTMLDialogElement, exV = document.getElementById('ex-v') as HTMLVideoElement
  document.querySelectorAll<HTMLButtonElement>('[data-ex]').forEach(b => b.addEventListener('click', () => {
    const m = exs[Number(b.dataset.ex)]
    exV.src = m.video; exV.poster = m.poster
    document.getElementById('ex-title')!.textContent = m.title
    const who = document.getElementById('ex-who') as HTMLAnchorElement
    who.textContent = '@' + m.handle; who.href = 'https://x.com/' + m.handle
    ;(document.getElementById('ex-post') as HTMLAnchorElement).href = m.post
    document.getElementById('ex-prompt')!.textContent = m.prompt
    ex.querySelector('details')!.open = false
    ex.showModal(); exV.play().catch(() => {})
  }))
  ex.querySelector('.close')!.addEventListener('click', () => ex.close())
  ex.addEventListener('click', e => { if (e.target === ex) ex.close() })
  ex.addEventListener('close', () => exV.pause())

  // the cat plays only while he's on screen
  const cat = document.getElementById('cat') as HTMLVideoElement
  if (move) new IntersectionObserver(([e]) => { if (e.isIntersecting) cat.play().catch(() => {}); else cat.pause() }, { rootMargin: '200px' }).observe(cat)
</script>
