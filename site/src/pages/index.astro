---
import '@fontsource-variable/albert-sans'
import '@fontsource/ibm-plex-mono/400.css'
import '@fontsource/ibm-plex-mono/500.css'
import '@fontsource/ibm-plex-mono/600.css'
import '../styles/global.css'
import Demo from '../components/Demo.astro'
import release from '../release.json'
import motion from '../data/motion.json'
import Pricing from '../components/Pricing.astro'
import { OFFERS, PRICING_FAQS, PLAN_SUMMARY, STARTER_CREDITS, fmt } from '../data/plans'

// the latest release; .github/workflows/release.yml refreshes src/release.json when AgentShot ships
const version = release.version
const dl = (f: string) => `https://github.com/hormuz-labs/agentshot/releases/download/v${version}/${f}`
const apt = `curl -fsSL https://apt.agentshot.si/manul.gpg | sudo gpg --batch --yes --dearmor -o /usr/share/keyrings/manul.gpg &&
echo "deb [signed-by=/usr/share/keyrings/manul.gpg] https://apt.agentshot.si stable main" | sudo tee /etc/apt/sources.list.d/manul.list &&
sudo apt update && sudo apt install manul`
const winPs = `iwr ${dl(`AgentShot-${version}-windows-x64-Setup.exe`)} -OutFile $env:TEMP\\AgentShot.exe; & $env:TEMP\\AgentShot.exe`
const brew = 'brew install hormuz-labs/tap/manul'
const agentPrompt = `Install AgentShot from https://github.com/hormuz-labs/agentshot and launch it (or run manul --worker on a headless machine):

  macOS:   ${brew}
  Windows: ${winPs}
  Linux:   ${apt.replaceAll('\n', ' ')}

Or download the .dmg, .exe, .deb or .AppImage for this machine from https://github.com/hormuz-labs/agentshot/releases/latest.`
const agentHtml = `<span class="c"># Install AgentShot and launch it (or run manul --worker on a headless machine):</span>

<span class="l">macOS</span>    <span class="p">$</span> ${brew}
<span class="l">Windows</span>  <span class="p">PS&gt;</span> iwr ${dl(`AgentShot-${version}-windows-x64-Setup.exe`)} -OutFile $env:TEMP\\AgentShot.exe; &amp; $env:TEMP\\AgentShot.exe
<span class="l">Linux</span>    <span class="p">$</span> ${apt.replaceAll('&', '&amp;').replaceAll('\n', '\n           ')}

<span class="c"># Or grab the .dmg, .exe, .deb or .AppImage from https://github.com/hormuz-labs/agentshot/releases/latest</span>`
const title = 'AgentShot: the open-source AI video agent — make and edit any video'
const description = 'AgentShot is an open-source video agent you talk to. Start from a blank canvas, a live web app or your own footage: it makes motion graphics, product walkthroughs, screen + facecam demos, voice and music, and edits on the word. For macOS, Windows and Linux, with a mobile companion and cloud or home workers.'
const gh = 'https://github.com/hormuz-labs/agentshot'
// motion examples from the gallery inside AgentShot: made by the people credited, with Claude; collected by prompt-motion.com.
// Videos and posters stream from AgentShot's bucket (scripts/publish-motion-gallery.mjs in the app's repo).
const media = 'https://storage.googleapis.com/manul-gallery/v1'
const clock = (s: number) => `${Math.floor(s / 60)}:${String(Math.round(s % 60)).padStart(2, '0')}`
// a trace under each line of the readout, drawn here so the page ships no script for it (600 × 28, seeded so it never changes)
let seed = 7
const rnd = () => ((seed = (seed * 16807) % 2147483647) / 2147483647)
const W = 600, H = 28
const f1 = (n: number) => Math.round(n * 10) / 10
function wordsTrace() {
  let x = 0, out = '', i = 0
  while (x < W) {
    const um = i === 4 || i === 17, w = um ? 9 : 6 + rnd() * 22
    i++
    out += `<rect x="${f1(x)}" y="${um ? 9 : 10}" width="${f1(w)}" height="${um ? 10 : 8}" class="${um ? 'r' : 'p'}"/>`
    x += w + (rnd() < .12 ? 14 + rnd() * 16 : 3)
  }
  return out
}
const voicesTrace = () => [[0, 70, 0], [70, 190, 1], [190, 240, 0], [240, 380, 1], [380, 470, 0], [470, 530, 1], [530, 600, 0]]
  .map(([a, b, v]) => `<rect x="${a}" y="${v ? 15 : 7}" width="${b - a - 2}" height="6" class="${v ? 'q' : 'p'}"/>`).join('')
function shotsTrace() {
  const cuts = [0, 46, 118, 150, 230, 268, 342, 400, 455, 520, 600]
  let out = ''
  cuts.slice(0, -1).forEach((a, i) => {
    const b = cuts[i + 1], shaky = i === 2 || i === 6, frozen = i === 8
    if (shaky) {
      let d = `M${a + 3} 14`
      for (let x = a + 3; x < b - 3; x += 4) d += ` L${x} ${f1(14 + (rnd() - .5) * 14)}`
      out += `<path d="${d}" class="rl"/>`
    } else out += `<rect x="${a + 2}" y="${frozen ? 6 : 12}" width="${b - a - 4}" height="${frozen ? 16 : 4}" class="${frozen ? 'h' : 'p'}"/>`
    if (i) out += `<rect x="${a - 1}" y="2" width="2" height="24" class="p"/>`
  })
  return out
}
function subjectTrace() {
  let d = '', band = ''
  for (let x = 0; x <= W; x += 10) {
    const y = 14 + Math.sin(x / 70) * 7 + Math.sin(x / 23) * 2
    d += `${x ? 'L' : 'M'}${x} ${f1(y)} `
    if (x % 60 === 0) band += `<rect x="${x - 4}" y="${f1(y - 10)}" width="8" height="20" class="h"/>`
  }
  return band + `<path d="${d}" class="rl"/>`
}
function musicTrace() {
  let out = ''
  for (let i = 0, x = 4; x < W; i++, x += 9.4) {
    const bar = i % 4 === 0, drop = i === 40
    out += `<rect x="${f1(x)}" y="${drop ? 0 : bar ? 4 : 10}" width="${drop ? 3 : 1.5}" height="${drop ? 28 : bar ? 20 : 8}" class="${drop ? 'r' : 'p'}"/>`
  }
  return out
}
function soundTrace() {
  let d = 'M0 26', x = 0
  while (x < W) {
    const quiet = rnd() < .1, w = quiet ? 10 + rnd() * 18 : 4
    d += ` L${f1(x)} ${quiet ? 26 : f1(26 - 6 - rnd() * 18)}`
    x += w
  }
  return `<path d="${d} L${W} 26 Z" class="pf"/>`
}
const svg = (inner: string) => `<svg viewBox="0 0 ${W} ${H}" preserveAspectRatio="none" aria-hidden="true">${inner}</svg>`
// the readout: what the agent reads about a film before it cuts (one 6-minute interview, with a song under it)
const log = [
  { k: 'Words', trace: svg(wordsTrace()), found: '2,417 words, each with its start and end; cut points moved into the quiet between them', say: 'cut the ums' },
  { k: 'Voices', trace: svg(voicesTrace()), found: 'two speakers, told apart by voice <i>A 61% · B 39%</i>', say: 'keep only Ravi’s answers' },
  { k: 'Shots', trace: svg(shotsTrace()), found: '38 shots <i>shaky at 00:52 and 02:10</i> <i>frozen 03:31–03:35</i> and the exposure and colour of each', say: 'lose the shaky bits' },
  { k: 'Subject', trace: svg(subjectTrace()), found: 'a face, followed through 37 of 38 shots, with a crop that keeps it in frame at 9:16, 1:1 and 4:5', say: 'now a vertical one for Reels' },
  { k: 'Music', trace: svg(musicTrace()), found: 'low-light.mp3 <i>92 BPM · 64 bars</i> builds at 01:08, drops at 01:24', say: 'cut to the beat after the drop' },
  { k: 'Sound', trace: svg(soundTrace()), found: '<i>−19 LUFS</i> 14 pauses over half a second, the loudest at 04:12', say: 'tighten the pauses' },
]
const faqs = [
  ...PRICING_FAQS,
  { q: 'Does my video get uploaded anywhere?', a: `No, not by default. Cutting, rendering and transcription happen on your computer. The model only receives text (your notes, the transcript) and, when it needs to look, a few still frames. If you pair the mobile app, it talks directly to your computer over Wi-Fi or Tailscale pinned to your desktop’s TLS certificate. If you choose a home or cloud worker, only the active project delta-syncs over the encrypted manul-mesh tunnel.` },
  { q: 'Can I use it from my phone, or on a remote worker?', a: `Yes. Open Settings → Mobile to pair the iOS or Android companion app with a 6-digit code over Wi-Fi or Tailscale: send clips from your camera roll, browse projects, draw boxes on the frame, chat live, and share exports. For heavy renders or working from a light laptop, run <code>manul --worker</code> on a home machine or lease a cloud worker on your AgentShot key — built-in userspace WireGuard (manul-mesh) links them without needing Tailscale installed.` },
  { q: 'Which AI does it use?', a: `Your pick, per project. Sign in for the AgentShot key and choose a tier (Low, Medium, High, and on Pro or Max, Max and Ultra), or bring your own Claude, Gemini or OpenAI key, or any OpenAI- or Anthropic-compatible endpoint. Your keys stay in your system’s keychain and are used first.` },
  { q: 'Do I need to know video editing?', a: `No. If you can describe what you want to a person, you can direct AgentShot. If you do know editing, you’ll get there faster: it understands “J-cut”, “punch in” and “duck the music”.` },
  { q: 'Do I have to type everything into the chat?', a: `No. Draw a box on the picture, drag across the timeline, or press N at a moment, and a message box opens right there: say what should change and press Enter. It goes to AgentShot with what you pointed at, and shows in the conversation so you can look back over it. Light by default, with a dark theme in Settings.` },
  { q: 'Does AgentShot generate video from scratch?', a: `Yes. Without any camera footage, it builds 60fps motion graphics from a blank canvas or 233 gallery examples, films narrated product walkthroughs in Chrome, and generates voiceover and music. Generated AI camera shots (b-roll on the fly, extending a frame, filling in a spot you box) are next — placed only where you ask, never swapping out your own footage.` },
  { q: 'What can’t it do yet?', a: `Generated AI camera shots, multi-camera sync beyond screen + facecam, handing the cut to Premiere, Resolve or Final Cut, publishing straight to YouTube, and a public API and MCP server. All are on the <a href="${gh}/blob/main/ROADMAP.md">roadmap</a>, in the open.` },
  { q: 'How is it different from CapCut, Descript, Motion or HyperFrames?', a: `CapCut, Premiere Pro, Final Cut Pro and DaVinci Resolve hand you a timeline to operate. Descript edits transcripts. HyperFrames and Remotion turn video into code in a terminal. Hosted video agents run only in someone else’s cloud. AgentShot is one open-source video agent for the whole job: make motion graphics, record product walkthroughs, sync screen + facecam, or cut footage on your own computer, from your phone, or on a worker.` },
  { q: 'Who makes it?', a: `Hormuz Labs, in the open. Issues, ideas and pull requests are welcome on <a href="${gh}">GitHub</a>. For teams and business, write to <a href="mailto:hello@hormuz-labs.dev">hello@hormuz-labs.dev</a>.` },
]
// the hero's prompt box: one example per kind of film; the chips swap it
const chips = [
  { k: 'Edit footage', p: 'Cut the ums and the restarts, keep only Ravi’s answers, and put quiet music under it.' },
  { k: 'Motion design', p: 'A 20-second logo reveal for @logo.png, in our colours, on a track with a clear beat.' },
  { k: 'Product walkthrough', p: 'Open app.example.com in Chrome, sign up and make a first project: film it at 60fps, zoom into clicks and add a voiceover.' },
  { k: 'Screen + facecam', p: 'Sync @screen.mp4 and @facecam.mp4, put me in a round corner PiP, and cut the dead air while keeping every click.' },
  { k: 'Clip highlights', p: 'Find the five best moments in this 40-minute podcast and make each a vertical Short with captions.' },
  { k: 'Article to video', p: 'Turn this blog post into a 60-second explainer with kinetic type, a voiceover and music.' },
  { k: 'Launch film', p: 'A 15-second launch film for our new feature, in the style of @reference.mp4.' },
]
// many kinds of films, one agent: what you say, what AgentShot does, what comes out
const ex = (id: string) => motion.find(m => m.id === id)!
const films = [
  { k: 'Edit footage', prompt: 'Make it cinematic, and put his name on screen.', steps: ['Measured the clip: one shot, one face, followed in every frame', 'Graded it and set it in a widescreen letterbox', 'Set his name in real type, in on the look', 'Rendered on your computer with ffmpeg', 'Before and after ready: keep it or send it back'], video: '/demo/cinema.mp4', poster: '/demo/cinema.webp', shape: 'wide', cap: 'The after, rendered by the same engine AgentShot drives' },
  { k: 'Motion design', prompt: `Use the “${ex('tdinh-me-815acb').title}” example, but reveal @logo.png in our colours.`, steps: ['Read the example’s prompt and studied the film', 'Asked for what it needed: the logo, two colours, a track', 'Showed a storyboard, one line per scene, before a frame', 'Built each scene as real motion graphics you can edit on the picture', 'Rendered 21 seconds at 1080p'], video: `/motion/tdinh-me-815acb.mp4`, poster: '/motion/tdinh-me-815acb.jpg', shape: 'wide', cap: `The example it starts from, by @${ex('tdinh-me-815acb').handle}` },
  { k: 'Product walkthrough', prompt: 'Walk through our web app in Chrome: filter the analytics, open a report, zoom into each click and narrate it.', steps: ['Explored the live web app in Chrome and proposed a step-by-step storyboard', 'Filmed a clean 60fps take with smooth cursor travel and click ripples', 'Zoomed into each interaction and wrote the narration per step', 'Generated the voiceover and paced the cut to match every sentence'], video: `/motion/robj3d3-b18fad.mp4`, poster: '/motion/robj3d3-b18fad.jpg', shape: 'wide', cap: `A product film from the gallery, by @${ex('robj3d3-b18fad').handle}` },
  { k: 'Screen + facecam', prompt: 'Sync my screen recording and facecam, put me in the corner, and cut the pauses.', steps: ['Aligned screen and camera recordings automatically by matching their audio', 'Placed the facecam in a rounded corner picture-in-picture overlay', 'Cut the dead air and hesitations while keeping all speech and screen action', 'Balanced the mic and rendered the composite at 60fps'], video: '/demo/zoom.mp4', poster: '/demo/zoom.webp', shape: 'wide', cap: 'The after, rendered by the same engine AgentShot drives' },
  { k: 'Shorts & Reels', prompt: 'Make it a Short with a caption.', steps: ['Found the subject and tracked him through the shot', 'Reframed 16:9 to 9:16 so he never leaves the frame', 'Timed the caption to the moment and burned it in', 'Exported 1080 × 1920, ready for Shorts, Reels and TikTok'], video: '/demo/short.mp4', poster: '/demo/short.webp', shape: 'tall', cap: 'The after, rendered by the same engine AgentShot drives' },
  { k: 'Launch video', prompt: 'A 15-second launch film for dub.co, like the Dub promo example. Go all out.', steps: ['Opened dub.co in its own browser for the product, colours and copy', 'Wrote the beats and a storyboard for you to approve', 'Cut every scene on the beat of the track', 'Made the voiceover and the music through your key', 'Exported 16:9 and a 9:16 cut for socials'], video: `/motion/steventey-0d20e4.mp4`, poster: '/motion/steventey-0d20e4.jpg', shape: 'wide', cap: `The example it starts from, by @${ex('steventey-0d20e4').handle}` },
]
// the line that fills in, letter by letter, as you scroll past it (split here so the page ships it ready)
const say = 'Start from raw footage, a live web app, or a blank canvas. Say what you want and point at the frame — AgentShot builds or cuts the film and hands every change back as a before and after.'
let sayN = 0
const sayWords = say.split(' ').map(w => [...w].map(c => ({ c, i: sayN++ })))
// a painting behind a panel: the image loads when the panel comes near (see .paint in the styles)
const paint = (name: string, pos = 'center', tint = '#e9e6da') => `--img:url(/paint/${name}.webp);--pos:${pos};--tint:${tint}`
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#fdfdf6" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon-48.png" sizes="48x48" type="image/png" />
  <link rel="icon" href="/favicon.png" sizes="32x32" type="image/png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="canonical" href="https://agentshot.si/" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://agentshot.si/" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content="https://agentshot.si/og.jpg" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="preload" href="/paint/steppe.webp" as="image" type="image/webp" />
  <!-- before first paint: "js" turns on the lazy paintings and reveals, "move" the scroll motion (not for reduced motion) -->
  <script is:inline>document.documentElement.classList.add('js'); if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('move')</script>
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: 'AgentShot', applicationCategory: 'MultimediaApplication',
    operatingSystem: 'macOS, Windows, Linux', offers: OFFERS, url: 'https://agentshot.si/', description: PLAN_SUMMARY,
    downloadUrl: `${gh}/releases/latest`, softwareVersion: version, license: `${gh}/blob/main/LICENSE`,
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org', '@type': 'VideoObject', name: 'AgentShot: you direct, it makes and edits the film',
    description: 'An 88-second film about AgentShot, the open-source video agent: start from footage or a blank canvas, say what you want, point at the frame, keep or send back each edit.',
    thumbnailUrl: 'https://agentshot.si/film/poster.jpg', contentUrl: 'https://agentshot.si/film/manul.mp4', uploadDate: '2026-10-07', duration: 'PT1M28S',
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: faqs.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, '') } })),
  })} />
</head>
<body>
  <header class="top" id="top">
    <div class="top-in">
      <nav aria-label="On this page">
        <a href="#films">Make &amp; Edit</a>
        <a href="#anywhere">Everywhere</a>
        <a href="#build">Developers</a>
        <a href="#pricing">Pricing</a>
        <a href="#fits" class="more">Compare</a>
        <a href="#faq" class="more">FAQ</a>
      </nav>
      <a class="brand" href="/" aria-label="AgentShot home"><img src="/icon-56.png" width="28" height="28" alt="" /><span>AgentShot</span></a>
      <div class="acts">
        <a class="gh" href={gh} aria-label="AgentShot on GitHub">
          <svg viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M8 0a8 8 0 0 0-2.53 15.59c.4.07.55-.17.55-.38v-1.34c-2.23.48-2.7-1.07-2.7-1.07-.36-.92-.89-1.17-.89-1.17-.73-.5.06-.49.06-.49.8.06 1.23.83 1.23.83.72 1.22 1.88.87 2.34.66.07-.52.28-.87.5-1.07-1.78-.2-3.65-.89-3.65-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.22 2.2.82a7.6 7.6 0 0 1 4 0c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.28.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48v2.2c0 .21.15.46.55.38A8 8 0 0 0 8 0Z"/></svg>
          <span>Star</span>
        </a>
        <a href="#get" class="btn sm">Download</a>
      </div>
    </div>
    <nav class="mob-nav" aria-label="Quick jump">
      <a href="#try">Try it</a>
      <a href="#films">Make &amp; Edit</a>
      <a href="#anywhere">Phone &amp; Cloud</a>
      <a href="#motion">233 Examples</a>
      <a href="#pricing">Pricing</a>
      <a href="#get">Install</a>
      <a href="#faq">FAQ</a>
    </nav>
  </header>

  <main>
    <section class="hero" aria-label="AgentShot">
      <div class="sky paint seen" style={paint('steppe', 'center 30%', '#bcd6ef')}>
        <div class="hero-copy">
          <a class="eyebrow" href="#get"><span class="dot-live" aria-hidden="true"></span><span>v<span data-version>{version}</span> · open source · macOS, Windows &amp; Linux</span></a>
          <h1 class="slate" aria-label="AgentShot, the open-source video agent.">
            <span class="w" style="--i:0" aria-hidden="true">AgentShot,</span> <span class="w" style="--i:1" aria-hidden="true">the</span> <span class="w ringed" style="--i:2" aria-hidden="true">open-source<svg viewBox="0 0 200 100" preserveAspectRatio="none" aria-hidden="true"><path pathLength="1" d="M150 14C96 0 22 8 9 46c-11 34 58 50 114 47 56-3 76-26 70-52-5-20-40-31-82-28"/></svg></span> <span class="w" style="--i:3" aria-hidden="true">video</span> <span class="w" style="--i:4" aria-hidden="true">agent.</span>
          </h1>
          <p class="lede">Make any video from scratch, or edit the footage you have. Motion graphics, narrated product walkthroughs, screen + facecam demos, Shorts, voice and music — on your own computer, from your phone, or on a cloud worker.</p>
          <div class="prompt" role="group" aria-label="An example of what you can ask">
            <p class="prompt-text" id="prompt-text" aria-live="polite">{chips[0].p}</p>
            <a class="prompt-go" href="#get" aria-label="Download AgentShot to try this"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" d="M12 19V5m0 0-6 6m6-6 6 6"/></svg></a>
          </div>
          <ul class="chips" role="list" aria-label="Kinds of video">
            {chips.map((c, i) => <li><button type="button" data-prompt={c.p} aria-pressed={i === 0 ? 'true' : 'false'}>{c.k}</button></li>)}
          </ul>
          <div class="cta-row">
            <a href="#get" class="btn dot" data-os-cta>
              <span class="ic"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" d="M12 4v11m0 0-4.5-4.5M12 15l4.5-4.5M5 20h14"/></svg></span>
              <span data-os-label>Download AgentShot</span>
            </a>
            <button class="btn light" type="button" data-film><i class="play" aria-hidden="true"></i>Watch the film <span class="mono dur">1:28</span></button>
          </div>
          <button class="brew mono" data-copy={brew} aria-label="Copy the Homebrew install command"><span>$ {brew}</span><em>copy</em></button>
        </div>

        <div class="stage" id="try" aria-label="Try AgentShot">
          <div class="glass"><Demo /></div>
          <ol class="steps" aria-hidden="true">
            <li><b>1</b>Give it a note</li>
            <li><b>2</b>Drag across the frame to compare</li>
            <li><b>3</b>Keep it, or send it back</li>
          </ol>
        </div>
      </div>
      <!-- size the editor to the window, so all of it is on the first screen -->
      <script is:inline>(() => {
        const st = document.getElementById('try'), g = st.firstElementChild
        const fit = () => {
          if (innerWidth < 900) { st.style.maxWidth = ''; return }
          let w = 1104
          for (let k = 0; k < 4; k++) {
            st.style.maxWidth = w + 'px'
            // layout sizes, not the bounding box: the editor is mid rise-in (shifted and scaled) when this first runs
            let top = 0
            for (let el = g; el; el = el.offsetParent) top += el.offsetTop
            const room = innerHeight - top - 18
            w = Math.round(Math.max(760, Math.min(1104, room * g.offsetWidth / g.offsetHeight)))
          }
          st.style.maxWidth = w + 'px'
        }
        fit(); addEventListener('resize', fit); document.fonts && document.fonts.ready.then(fit)
      })()</script>
      <p class="credit wrap">Clip: Timofey the Pallas’s cat, Moscow Zoo, CC BY 4.0. Each “after” was rendered by the same engine AgentShot drives. <span class="phone-only">Desktop app for macOS, Windows and Linux, with a companion app for iPhone and Android.</span></p>
    </section>

    <section class="say" id="say" aria-label={say}>
      <div class="say-pin">
        <div class="paint say-card" style={paint('mist', 'center', '#e4ebe2')}>
          <p class="kicker">From a blank canvas or raw footage to a finished film</p>
