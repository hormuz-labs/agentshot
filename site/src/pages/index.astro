<script>
  // where you start: tabs, and the shown result plays while it's on screen
  const move = !matchMedia('(prefers-reduced-motion: reduce)').matches
  const ftabs = [...document.querySelectorAll<HTMLButtonElement>('[data-ftab]')]
  const fpanels = ftabs.map(t => document.getElementById(t.getAttribute('aria-controls')!)!)
  let filmsOn = false
  const fvideo = (i: number) => fpanels[i].querySelector('video') as HTMLVideoElement
  const fplay = (i: number) => { const v = fvideo(i); if (!v.src) v.src = v.dataset.src!; if (filmsOn && move) v.play().catch(() => {}) }
  const fshow = (n: number) => ftabs.forEach((t, i) => {
    const on = i === n
    t.setAttribute('aria-selected', String(on)); t.tabIndex = on ? 0 : -1
    fpanels[i].hidden = !on
    if (on) fplay(i); else fvideo(i).pause()
  })
  ftabs.forEach((t, i) => {
    t.addEventListener('click', () => fshow(i))
    t.addEventListener('keydown', e => {
      const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0
      if (d) { const n = (i + d + ftabs.length) % ftabs.length; fshow(n); ftabs[n].focus() }
    })
  })
  new IntersectionObserver(([e]) => {
    filmsOn = e.isIntersecting
    const i = ftabs.findIndex(t => t.getAttribute('aria-selected') === 'true')
    if (filmsOn) fplay(i); else fvideo(i).pause()
  }, { rootMargin: '200px' }).observe(document.getElementById('make')!)

  // the film opens in a player over the page
  const film = document.getElementById('film') as HTMLDialogElement, filmV = document.getElementById('film-v') as HTMLVideoElement
  document.querySelectorAll('[data-film]').forEach(b => b.addEventListener('click', () => { film.showModal(); filmV.play().catch(() => {}) }))
  film.querySelector('.close')!.addEventListener('click', () => film.close())
  film.addEventListener('click', e => { if (e.target === film) film.close() })
  film.addEventListener('close', () => filmV.pause())

  // motion examples: small silent previews from this site, fetched a screen early, playing while on screen;
  // a click opens the full one with sound and the prompt behind it
  const warm = new IntersectionObserver(es => es.forEach(e => {
    if (!e.isIntersecting) return
    const v = e.target as HTMLVideoElement
    v.preload = 'auto'; v.src = v.dataset.src!; warm.unobserve(v)
  }), { rootMargin: '120% 60%' })
  const reels = new IntersectionObserver(es => es.forEach(e => {
    const v = e.target as HTMLVideoElement
    if (e.isIntersecting && move) { if (!v.src) v.src = v.dataset.src!; v.play().catch(() => {}) } else v.pause()
  }), { threshold: 0.15 })
  document.querySelectorAll<HTMLVideoElement>('.reels video').forEach(v => { warm.observe(v); reels.observe(v) })
  const exs = JSON.parse(document.getElementById('ex-data')!.textContent!)
  const ex = document.getElementById('ex') as HTMLDialogElement, exV = document.getElementById('ex-v') as HTMLVideoElement
  document.querySelectorAll<HTMLButtonElement>('[data-ex]').forEach(b => b.addEventListener('click', () => {
    const m = exs[Number(b.dataset.ex)]
    exV.src = m.video; exV.poster = m.poster
    document.getElementById('ex-title')!.textContent = m.title
    const who = document.getElementById('ex-who') as HTMLAnchorElement
    who.textContent = '@' + m.handle; who.href = 'https://x.com/' + m.handle
    ;(document.getElementById('ex-post') as HTMLAnchorElement).href = m.post
    document.getElementById('ex-prompt')!.textContent = m.prompt
    ex.querySelector('details')!.open = false
    ex.showModal(); exV.play().catch(() => {})
  }))
  ex.querySelector('.close')!.addEventListener('click', () => ex.close())
  ex.addEventListener('click', e => { if (e.target === ex) ex.close() })
  ex.addEventListener('close', () => exV.pause())

  // the cat plays only while he's on screen, and not at all for people who'd rather nothing moved
  const cat = document.getElementById('cat') as HTMLVideoElement
  if (move) new IntersectionObserver(([e]) => { if (e.isIntersecting) cat.play().catch(() => {}); else cat.pause() }, { rootMargin: '200px' }).observe(cat)
</script>
