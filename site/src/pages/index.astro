    <section class="motion" id="motion">
      <div class="wrap sh" data-r>
        <h2 class="slate">No footage? Start from these.</h2>
        <p>Pick any of 233 motion videos in AgentShot, each with the prompt that made it. Say what yours is about; AgentShot makes it the same way.</p>
      </div>
      <div class="panel paint" style={paint('bluehour', 'center', '#d9d3e6')}>
        <ul class="reels" role="list">
          {motion.map((m, i) => (
            <li data-r style={`--d:${i % 3}`}>
              <button type="button" class="reel-tile" data-ex={i} aria-label={`Play “${m.title}” by @${m.handle}`}>
                <video data-src={`/motion/${m.id}.mp4`} poster={`/motion/${m.id}.jpg`} muted loop playsinline preload="none" width="768" height="432" aria-hidden="true"></video>
                <span class="slug"><span>@{m.handle}</span><span class="mono">{clock(m.duration)}</span></span>
