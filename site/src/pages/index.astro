        </div>
      </div>
    </section>

    <section class="films" id="films">
      <div class="wrap sh" data-r>
        <h2 class="slate">Video anything. One agent.</h2>
        <p>Start with raw camera clips, a live URL, a screen recording, or nothing at all. Brief AgentShot the way you’d brief a creative director or an editor — it plans the scenes, builds or cuts the film, and hands back a before and after.</p>
      </div>
      <div class="panel paint" style={paint('dusk', 'center 40%', '#f1c79d')}>
        <div class="film-tabs" role="tablist" aria-label="Kinds of film">
          {films.map((f, i) => <button role="tab" id={`ft-${i}`} aria-controls={`fp-${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-ftab={i}>{f.k}</button>)}
        </div>
        {films.map((f, i) => (
          <div class="film-panel sheet" role="tabpanel" id={`fp-${i}`} aria-labelledby={`ft-${i}`} hidden={i !== 0}>
            <div class="fp-flow">
              <div class="fp-block">
                <p class="lbl">You say</p>
                <q class="fp-prompt">{f.prompt}</q>
              </div>
              <div class="fp-block">
                <p class="lbl">AgentShot</p>
                <ol class="fp-steps">{f.steps.map(st => <li>{st}</li>)}</ol>
              </div>
            </div>
            <figure class:list={['fp-result', f.shape]}>
              <video data-src={f.video} poster={f.poster} muted loop playsinline preload="none" aria-label={`Result: ${f.k}`}></video>
              <figcaption>{f.cap}</figcaption>
            </figure>
          </div>
        ))}
        <p class="note">Also: talking heads, tutorials, article-to-video explainers, custom voiceover &amp; music, and audio/video cleanup.</p>
