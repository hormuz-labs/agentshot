---
// The guides: how-to articles for the jobs AgentShot does.
import Base from '../../layouts/Base.astro'
import Cta from '../../components/Cta.astro'
import { GUIDES, guidePath } from '../../data/guides'
const title = 'Video Editing Guides: demos, Shorts, captions and motion graphics · AgentShot'
const description = 'Step-by-step guides to making better videos faster: removing filler words, product demos, turning podcasts into Shorts, captions, and motion graphics with AI.'
const url = 'https://agentshot.si/guides/'
---
<Base title={title} description={description} image="/og/guides.jpg">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org', '@type': 'CollectionPage', name: title, description, url,
      mainEntity: { '@type': 'ItemList', itemListElement: GUIDES.map((g, i) => ({ '@type': 'ListItem', position: i + 1, name: g.h1, url: `https://agentshot.si${guidePath(g.slug)}` })) },
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'AgentShot', item: 'https://agentshot.si/' },
        { '@type': 'ListItem', position: 2, name: 'Guides', item: url },
      ],
    })} />
  </Fragment>
  <main class="guides wrap">
    <header class="sec-head">
      <span class="tag">guides</span>
      <h1>How to make it. <span class="grad">The long way and the short way.</span></h1>
      <p>Each guide explains how the job is done properly, step by step, then shows the one sentence that does it in AgentShot.</p>
    </header>
    <ul class="guide-cards" role="list" data-hero-cta>
      {GUIDES.map(g => (
        <li style={`--c: var(--${g.tone})`}>
          <a href={guidePath(g.slug)}>
            <span class="mono">{g.minutes} min read · {g.steps.length} steps</span>
            <h2>{g.h1}</h2>
            <p>{g.description}</p>
            <span class="read">Read the guide <span aria-hidden="true">→</span></span>
          </a>
        </li>
      ))}
    </ul>
    <section class="try-editor" aria-labelledby="try-h"><h2 id="try-h">Or skip to <span class="grad">the short way.</span></h2><p>AgentShot is free and open source, and runs on your computer. Say what you want and compare the before and after.</p><div class="plan-cta"><Cta /></div></section>
  </main>
</Base>

<style>
  .guides { padding-top: clamp(44px, 7vw, 96px); padding-bottom: 56px; }
  .sec-head { max-width: 1000px; margin-bottom: 40px; }
  .sec-head h1 { font-size: clamp(40px, 5.6vw, 76px); line-height: 1; letter-spacing: -.04em; }
  h1 .grad { display: block; margin-top: 8px; }
  .guide-cards { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; margin: 0; padding: 0; list-style: none; }
  .guide-cards a { display: flex; flex-direction: column; height: 100%; padding: clamp(24px, 3vw, 36px); border: 1px solid var(--line); border-radius: var(--r); background: linear-gradient(145deg, color-mix(in srgb, var(--c) 7%, var(--bg-2)), var(--bg-2) 65%); box-shadow: inset 0 3px var(--c); color: var(--ink); text-decoration: none; }
  .guide-cards a:hover { border-color: color-mix(in srgb, var(--c) 50%, var(--line)); }
  .guide-cards .mono { font-size: 12px; color: var(--ink-2); }
  .guide-cards h2 { margin-top: 16px; font-size: clamp(24px, 2.6vw, 34px); line-height: 1.12; }
  .guide-cards p { margin: 12px 0 24px; color: var(--ink-2); font-size: 16px; }
  .read { margin-top: auto; font-size: 14px; font-weight: 700; }
  .try-editor { margin-top: var(--gap); }
  .try-editor p { margin-top: 20px; color: var(--ink-2); max-width: 700px; }
  .plan-cta { max-width: 580px; margin-top: 28px; }
  @media (max-width: 760px) { .guide-cards { grid-template-columns: minmax(0, 1fr); } }
</style>
