---
// The plans: free with your own keys, or an AgentShot plan with credits shared with Pitch. Used on the home page (#pricing)
// and on /pricing, where `full` adds the extras. Subscribing happens in the app, so the paid buttons lead to the download.
import Cta from './Cta.astro'
import { PLANS, FLEX, ENTERPRISE, TIERS, PITCH, STARTER_CREDITS, LAUNCH_DISCOUNT, fmt } from '../data/plans'

interface Props { heading?: 'h1' | 'h2'; full?: boolean }
const { heading = 'h2', full = false } = Astro.props
const H = heading
const [local, ...paid] = PLANS
---
<section class="sec wrap" id="pricing" aria-labelledby="pricing-h">
  <div class="sec-head">
    <H id="pricing-h">Free with your own key.</H>
    <p>Bring a Claude, Gemini or OpenAI key and AgentShot costs nothing, for good. You pay your provider, usually cents per edit. Or take one AgentShot key that covers every model, voice and music.</p>
  </div>

  <ol class="plans" role="list">
    <li class="plan free" aria-labelledby={`plan-${local.key}`}>
      <h3 id={`plan-${local.key}`}>{local.name}</h3>
      <p class="price"><span class="amt">{local.price}</span> <span class="per">{local.per}</span></p>
      <p class="yr">No card. No account needed. No watermark.</p>
      <ul class="feats">{local.features.map(f => <li>{f}</li>)}</ul>
      <div class="plan-cta"><Cta /></div>
    </li>
    {paid.map(p => (
      <li class="plan" aria-labelledby={`plan-${p.key}`}>
        <h3 id={`plan-${p.key}`}>{p.name}</h3>
        <p class="price"><span class="amt">{p.price}</span> <span class="per">{p.per}</span></p>
        <p class="yr">or ${fmt(p.annual!.price)} a year, {fmt(p.annual!.credits)} credits upfront. Save {p.annual!.save}%.</p>
        <ul class="feats">{p.features.map(f => <li>{f}</li>)}</ul>
        <a href={p.cta.href} class="btn ghost">{p.cta.label}</a>
      </li>
    ))}
  </ol>

  {LAUNCH_DISCOUNT > 0 && <p class="fine"><b>Launch offer:</b> every model at {LAUNCH_DISCOUNT}% off, so credits go twice as far on the AgentShot key. For a limited time.</p>}
  <p class="fine">New AgentShot accounts start with {fmt(STARTER_CREDITS)} free credits. Subscribe or cancel in the app, under Settings → Keys → AgentShot key. Your own keys keep working alongside a plan and are used first.{!full && <> <a href="/pricing/">Full pricing</a></>}</p>

  {full && (
    <>
      <div class="extras">
        <div>
          <h3>{FLEX.name}</h3>
          <p class="price small"><span class="amt">${FLEX.price}</span> <span class="per">once</span></p>
          <p>{fmt(FLEX.credits)} more credits when a project runs long. Needs an active Pro or Max plan.</p>
        </div>
        <div>
          <h3>{ENTERPRISE.name}</h3>
          <p class="price small"><span class="amt">Let’s talk</span></p>
          <p>{ENTERPRISE.blurb} <a href={ENTERPRISE.href}>Email us</a>.</p>
        </div>
      </div>
      <div class="tiers">
        <div>
          <h3>Model tiers on the AgentShot key</h3>
          <p>Pick a tier per project. Plans unlock the strongest models. Credits never expire once they’re yours.</p>
        </div>
        <ul role="list" aria-label="Model tiers and who can use them">
          {TIERS.map(t => <li><b>{t.name}</b><span>{t.who}</span></li>)}
        </ul>
      </div>
      <p class="fine">{PITCH}</p>
      <p class="fine">Prices in US dollars. Annual plans grant the year’s credits on day one. Billing is handled by Dodo Payments.</p>
    </>
  )}
</section>

<style>
  .plans { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1.25fr 1fr 1fr; border: 1px solid var(--line); }
  .plan { display: flex; flex-direction: column; padding: clamp(22px, 2.6vw, 34px); border-left: 1px solid var(--line); }
  .plan:first-child { border-left: 0; }
  .plan.free { background: var(--bg-2); }
  .price { margin-top: 14px; }
  .amt { font: 800 clamp(54px, 6vw, 76px)/1 var(--sans); font-stretch: 82%; }
  .per { color: var(--ink-3); }
  .yr { margin-top: 8px; min-height: 3.1em; font-size: 15.5px; line-height: 1.4; color: var(--ink-2); }
  .feats { flex: 1; margin: 16px 0 26px; padding: 0; list-style: none; border-top: 1px solid var(--line); }
  .feats li { padding: 10px 0; border-bottom: 1px solid var(--line); font-size: 15.5px; line-height: 1.35; color: var(--ink-2); }
  .plan-cta { display: grid; }
  .fine { margin-top: 14px; max-width: 820px; font-size: 15px; color: var(--ink-3); }
  .fine b { color: var(--ink); }
  .extras { display: grid; grid-template-columns: 1fr 1fr; margin-top: 36px; border: 1px solid var(--line); }
  .extras > div { padding: 24px; }
  .extras > div + div { border-left: 1px solid var(--line); }
  .extras p:not(.price) { margin-top: 10px; font-size: 15.5px; color: var(--ink-2); }
  .price.small .amt { font-size: 36px; }
  .tiers { display: grid; grid-template-columns: 1fr 1.3fr; gap: 24px; align-items: center; margin-top: 16px; padding: 24px; border: 1px solid var(--line); }
  .tiers p { margin-top: 8px; font-size: 15.5px; color: var(--ink-2); }
  .tiers ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 1px; background: var(--line); }
  .tiers li { display: grid; gap: 4px; padding: 12px 8px; background: var(--bg-2); text-align: center; }
  .tiers span { font-size: 13px; color: var(--ink-3); }
  @media (max-width: 900px) {
    .plans, .extras, .tiers { grid-template-columns: 1fr; }
    .plan { border-left: 0; border-top: 1px solid var(--line); }
    .plan:first-child { border-top: 0; }
    .extras > div + div { border-left: 0; border-top: 1px solid var(--line); }
    .yr { min-height: 0; }
    .tiers ul { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
</style>
