---
import Base from '../layouts/Base.astro'

interface Props {
  title: string
  description: string
  eyebrow: string
  effective?: string
}

const { title, description, eyebrow, effective = 'October 11, 2026' } = Astro.props
---
<Base title={`${title} · AgentShot`} description={description}>
  <main class="wrap">
    <header class="title">
      <p class="eyebrow">{eyebrow}</p>
      <h1>{title}</h1>
      <p class="effective">Effective {effective}</p>
    </header>
    <article>
      <slot />
    </article>
  </main>
</Base>

<style>
  .title { max-width: 860px; margin: 0 auto; padding-top: clamp(48px, 8vw, 96px); }
  .eyebrow { margin-bottom: 14px; font: 500 14px/1.2 var(--mono); color: var(--ink-3); }
  h1 { font-size: clamp(42px, 6.5vw, 80px); }
  .effective { margin-top: 16px; font-size: 15px; color: var(--ink-3); }
  article { max-width: 860px; margin: 0 auto; padding-top: 48px; }
  article :global(.intro) { margin: 0 0 40px; color: var(--ink); font-size: clamp(20px, 2vw, 23px); line-height: 1.4; }
  article :global(section) { margin-top: 40px; padding-top: 28px; border-top: 1px solid var(--line); }
  article :global(h2) { margin: 0 0 16px; font-size: clamp(26px, 3vw, 34px); }
  article :global(h3) { margin: 28px 0 8px; font-size: 20px; }
  article :global(p), article :global(li) { color: var(--ink-2); }
  article :global(p) { margin: 0 0 16px; }
  article :global(ul) { margin: 14px 0 20px; padding-left: 22px; }
  article :global(li) { margin: 8px 0; }
  article :global(strong) { color: var(--ink); }
</style>
