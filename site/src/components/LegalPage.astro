---
import '@fontsource-variable/albert-sans'
import '@fontsource/ibm-plex-mono/500.css'
import '../styles/global.css'

interface Props {
  title: string
  description: string
  eyebrow: string
  effective?: string
}

const { title, description, eyebrow, effective = 'October 11, 2026' } = Astro.props
const canonical = new URL(Astro.url.pathname, 'https://agentshot.si')
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} · AgentShot</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#fdfdf6" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon-48.png" sizes="48x48" type="image/png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="canonical" href={canonical} />
</head>
<body>
  <header class="top wrap">
    <a class="brand" href="/" aria-label="AgentShot home"><img src="/icon-56.png" width="28" height="28" alt="" /><span>AgentShot</span></a>
    <nav aria-label="Legal pages">
      <a href="/privacy/">Privacy</a>
      <a href="/terms/">Terms</a>
      <a href="https://github.com/hormuz-labs/agentshot">GitHub ↗</a>
    </nav>
  </header>

  <main class="wrap">
    <header class="title">
      <p class="eyebrow"><span aria-hidden="true"></span>{eyebrow}</p>
      <h1 class="slate">{title}</h1>
      <p class="effective">Effective {effective}</p>
    </header>
    <article>
      <slot />
    </article>
  </main>

  <footer class="wrap label">
    <span>© Hormuz Labs · <a href="/privacy/">Privacy</a> · <a href="/terms/">Terms</a></span>
    <a href="/">Back to AgentShot</a>
  </footer>

  <style>
    .top { display: flex; align-items: center; justify-content: space-between; gap: 24px; min-height: 64px; }
    .brand { display: inline-flex; align-items: center; gap: 9px; text-decoration: none; font: 800 19px/1 var(--sans); letter-spacing: -.02em; }
    .brand img { border-radius: 7px; }
    nav { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 4px; }
    nav a { padding: 8px 12px; border-radius: 8px; color: var(--ink); font: 500 14px/1 var(--sans); text-decoration: none; }
    nav a:hover { background: rgba(38, 38, 38, .06); }

    main { padding-block: 24px 110px; }
    .title { display: flex; flex-direction: column; align-items: center; text-align: center; padding: clamp(56px, 8vw, 96px) 20px; border-radius: var(--r-lg); background: url(/paint/steppe.webp) center 35% / cover, #bcd6ef; }
    .eyebrow { display: inline-flex; align-items: center; gap: 8px; margin: 0 0 20px; padding: 7px 14px; border-radius: 999px; background: rgba(255, 255, 255, .6); font: 600 13.5px/1.2 var(--sans); }
    .eyebrow span { width: 7px; height: 7px; border-radius: 50%; background: var(--amber); }
    h1 { margin: 0; font-size: clamp(42px, 6vw, 72px); letter-spacing: -.035em; }
    .effective { margin: 16px 0 0; color: var(--ink-2); font: 500 14px/1.5 var(--sans); }
    article { max-width: 760px; margin: 0 auto; padding-top: 64px; }
    article :global(.intro) { margin: 0 0 48px; color: var(--ink-2); font-size: clamp(20px, 2vw, 24px); line-height: 1.45; }
    article :global(section) { margin-top: 44px; padding-top: 32px; border-top: 1px solid var(--line); }
    article :global(h2) { margin: 0 0 16px; font-size: clamp(26px, 3vw, 32px); }
    article :global(h3) { margin: 28px 0 8px; font-size: 19px; line-height: 1.25; }
    article :global(p), article :global(li) { color: var(--ink-2); }
    article :global(p) { margin: 0 0 16px; }
    article :global(ul) { margin: 14px 0 20px; padding-left: 24px; }
    article :global(li) { margin: 8px 0; padding-left: 4px; }
    article :global(a) { color: var(--ink); text-decoration-color: var(--amber); text-underline-offset: 3px; }
    article :global(a:hover) { color: var(--amber-ink); }
    article :global(strong) { color: var(--ink); }

    footer { display: flex; justify-content: space-between; gap: 16px 28px; flex-wrap: wrap; padding-block: 26px 80px; border-top: 1px solid var(--line); font-size: 14px; line-height: 1.6; }
    footer a { color: var(--ink-2); text-underline-offset: 3px; }
    footer a:hover { color: var(--ink); }

    @media (max-width: 640px) {
      .top { padding-block: 10px; }
      nav a:last-child { display: none; }
      main { padding-block: 12px 80px; }
      .title { border-radius: 22px; }
      article { padding-top: 44px; }
      article :global(.intro) { margin-bottom: 40px; }
    }
  </style>
</body>
</html>
