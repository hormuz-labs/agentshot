---
// The download buttons: all three systems, with the visitor's own first and in yellow. On a phone, where a desktop app
// can't install, they give way to a button that sends the link to the visitor's computer. The head script sets
// html[data-os] before first paint. `small` is the header's single button, which leads to the install section.
import { MAC_ARM, WINDOWS } from '../data/download'

interface Props { small?: boolean }
const { small = false } = Astro.props
---
{small
  ? <a class="btn go sm" href="/#get">Download</a>
  : <>
      <div class="dl-set">
        <a class="btn" href={MAC_ARM} data-dl="mac" aria-label="Download for Mac"><span class="pre">Download for&nbsp;</span>Mac</a>
        <a class="btn" href={WINDOWS} data-dl="win" aria-label="Download for Windows"><span class="pre">Download for&nbsp;</span>Windows</a>
        <a class="btn" href="/#get" data-dl="linux" aria-label="Download for Linux"><span class="pre">Download for&nbsp;</span>Linux</a>
      </div>
      <button type="button" class="btn go" data-send>Send to my computer</button>
    </>}
