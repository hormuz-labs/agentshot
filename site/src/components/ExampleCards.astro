---
// A grid of motion examples: poster, title and who made it. Posters load as they scroll into view, except the
// first `eager` of them, which a gallery page shows straight away.
import { examplePath, examplePoster, type Example } from '../data/examples'
interface Props { examples: Example[]; eager?: number }
const { examples, eager = 0 } = Astro.props
---
<ul class="example-cards" role="list">
  {examples.map((e, i) => (
    <li>
      <a href={examplePath(e.id)}>
        <img src={examplePoster(e.id)} alt="" width={e.width} height={e.height} loading={i < eager ? 'eager' : 'lazy'} decoding="async" />
        <span class="t">{e.title}</span>
        <span class="by mono">@{e.handle} · {Math.round(e.duration)}s</span>
      </a>
    </li>
  ))}
</ul>

<style>
  .example-cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px 16px; margin: 0; padding: 0; list-style: none; }
  li { min-width: 0; }
  a { display: flex; flex-direction: column; gap: 6px; color: var(--ink); text-decoration: none; }
  img { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; border: 1px solid var(--line); border-radius: 14px; background: var(--bg-2); transition: border-color .2s; }
  a:hover img { border-color: var(--ink-3); }
  .t { margin-top: 4px; font-weight: 700; font-size: 16px; line-height: 1.3; overflow-wrap: anywhere; }
  .by { font-size: 12px; color: var(--ink-2); overflow-wrap: anywhere; }
  @media (max-width: 900px) { .example-cards { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 480px) { .example-cards { grid-template-columns: minmax(0, 1fr); } }
  @media (prefers-reduced-motion: reduce) { img { transition: none; } }
</style>
