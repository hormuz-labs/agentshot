{
  "expo": {
    "name": "Manul",
    "slug": "manul",
    "scheme": "manul",
    "version": "0.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Manul talks to the Manul app on your Mac over your Wi-Fi.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      },
      "bundleIdentifier": "com.hormuzlabs.manul.mobile",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.hormuzlabs.manul.mobile"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#fbfbf9",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Manul uses the camera to scan the pairing code on your Mac and to film for your projects.",
          "microphonePermission": "Manul records sound with the videos you film for your projects.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Manul sends the videos and photos you choose to a project on your Mac."
        }
      ],
      "@bacons/apple-targets"
    ]
  }
}
