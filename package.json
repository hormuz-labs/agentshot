{
  "name": "manul",
  "productName": "Manul",
  "version": "0.0.1",
  "private": true,
  "license": "FSL-1.1-ALv2",
  "description": "An agentic video editor. Drop in a video, say what you want, and it does it.",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "node scripts/run-electron.mjs dev",
    "build": "electron-vite build",
    "account:dev": "node --env-file=gateway/.env account/local.mjs",
    "account:build": "node scripts/build-account.mjs",
    "start": "node scripts/run-electron.mjs preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "smoke": "electron-vite build && node scripts/smoke.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:mascot": "electron-vite build && node test/e2e/mascot.e2e.mjs",
    "postinstall": "node scripts/fetch-ffmpeg.mjs && node scripts/fetch-bsk.mjs && node scripts/fetch-models.mjs && node scripts/copy-libs.mjs",
    "fetch:ffmpeg": "node scripts/fetch-ffmpeg.mjs",
    "fetch:bsk": "node scripts/fetch-bsk.mjs",
    "test:e2e": "electron-vite build && node test/e2e/filmstrip.e2e.mjs && node test/e2e/clips.e2e.mjs && node test/e2e/export.e2e.mjs && node test/e2e/menu.e2e.mjs && node test/e2e/proxy.e2e.mjs && node test/e2e/tabs.e2e.mjs && node test/e2e/resize.e2e.mjs && node test/e2e/inline.e2e.mjs && node test/e2e/drag.e2e.mjs && node test/e2e/files.e2e.mjs && node test/e2e/browser.e2e.mjs && node test/e2e/conversations.e2e.mjs && node test/e2e/tools.e2e.mjs && node test/e2e/providers.e2e.mjs && node test/e2e/manul-key.e2e.mjs",
    "package": "electron-vite build && electron-builder",
    "package:dir": "electron-vite build && electron-builder --dir"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/vite": "^4.3.3",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^5.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "esbuild": "0.25.12",
    "gsap": "^3.15.0",
    "lucide-react": "^1.52.0",
    "playwright-core": "^1.62.0-alpha-2026-06-29",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.1",
    "typescript": "5.9",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@ag-ui/core": "^1.0.2",
    "@earendil-works/chord": "^1.0.4",
    "@earendil-works/pi-ai": "^1.0.4",
    "@earendil-works/pi-durable": "^1.0.4",
    "@sentry/electron": "^8.1.0",
    "electron-updater": "^6.8.9",
    "isomorphic-git": "^1.43.0",
    "js-yaml": "^4.3.2",
    "pg": "^8.23.1",
    "yauzl": "^3.4.0"
  },
  "author": {
    "name": "Hormuz Labs",
    "email": "hello@hormuz-labs.dev"
  },
  "homepage": "https://github.com/hormuz-labs/manul"
}
